{%- comment -%}
  Free shipping progress for the cart. Shows nothing when the theme setting "Envío gratis desde" is empty or 0.
{%- endcomment -%}
{%- liquid
  assign free_shipping_threshold = settings.nekova_free_shipping_threshold | default: 0 | times: 100
-%}
{%- if free_shipping_threshold > 0 and cart.item_count > 0 -%}
  <div class="nekova-free-shipping" role="status">
    {%- if cart.total_price >= free_shipping_threshold -%}
      <p><strong>¡Tu compra tiene envío gratis!</strong></p>
      <span class="nekova-free-shipping-bar"><span style="width: 100%;"></span></span>
    {%- else -%}
      {%- liquid
        assign free_shipping_missing = free_shipping_threshold | minus: cart.total_price
        assign free_shipping_percent = cart.total_price | times: 100 | divided_by: free_shipping_threshold
      -%}
      <p>Te faltan <strong>{{ free_shipping_missing | money_without_trailing_zeros }}</strong> para el envío gratis.</p>
      <span class="nekova-free-shipping-bar"><span style="width: {{ free_shipping_percent }}%;"></span></span>
    {%- endif -%}
  </div>
  <style>
    .nekova-free-shipping { background: var(--nekova-accent-soft); border-radius: var(--nekova-radius); color: var(--nekova-ink); font-family: var(--nekova-font-body); font-size: 1.4rem; margin-bottom: 1.6rem; padding: 1.2rem 1.6rem; text-align: left; }
    .nekova-free-shipping p { margin: 0 0 .8rem; }
    .nekova-free-shipping strong { color: var(--nekova-accent); }
    .nekova-free-shipping-bar { background: var(--nekova-surface); border-radius: var(--nekova-radius-pill); display: block; height: .6rem; overflow: hidden; }
    .nekova-free-shipping-bar span { background: var(--nekova-accent); border-radius: inherit; display: block; height: 100%; }
  </style>
{%- endif -%}
