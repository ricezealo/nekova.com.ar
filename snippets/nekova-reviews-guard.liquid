{%- comment -%}
  Collapses a reviews band ([data-nk-reviews]) while the app inside renders nothing visible
  (Judge.me loads asynchronously and hides its widget when there are no reviews).
  Uses a zero-height class instead of `hidden` so the app content can still be measured,
  and opens the band as soon as the app shows reviews. Not applied in the theme editor.
{%- endcomment -%}
<style>
  .nk-reviews-empty { height: 0 !important; margin: 0 !important; overflow: hidden !important; padding: 0 !important; visibility: hidden; }
</style>
<script>
  (() => {
    document.querySelectorAll('[data-nk-reviews]:not([data-nk-reviews-ready])').forEach((band) => {
      band.dataset.nkReviewsReady = 'true';
      const inner = band.querySelector('[data-nk-reviews-inner]');
      if (!inner || (window.Shopify && window.Shopify.designMode)) return;
      const check = () => band.classList.toggle('nk-reviews-empty', inner.offsetHeight < 80);
      check();
      [800, 2000, 4000, 8000].forEach((ms) => setTimeout(check, ms));
      new MutationObserver(check).observe(inner, { attributes: true, childList: true, subtree: true });
    });
  })();
</script>
