      <rect x="3" y="13" width="18" height="6" rx="3"/><path d="M5 13c0-3.3 3.1-6 7-6s7 2.7 7 6"/><path d="M12 3v3"/>
    {%- when 'slot' -%}
      <path d="M4 7c0 7 1.5 12 8 12s8-5 8-12"/><path d="M10 5v6a2 2 0 004 0V5"/>
    {%- when 'sides' -%}
