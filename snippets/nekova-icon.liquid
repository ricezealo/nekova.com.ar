    {%- when 'wind' -%}
      <path d="M3 9h11a3 3 0 10-3-3M3 15h15a3 3 0 11-3 3M3 12h8"/>
    {%- when 'zip' -%}
      <path d="M12 3v18"/><path d="M10 6h4M10 9h4M10 12h4"/><rect x="9.5" y="14" width="5" height="5" rx="1.5"/>
    {%- when 'ear' -%}
