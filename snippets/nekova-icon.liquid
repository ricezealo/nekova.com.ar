    {%- when 'return' -%}
      <path d="M4 10h11a5 5 0 010 10H9"/><path d="M8 6l-4 4 4 4"/>
    {%- when 'card' -%}
      <rect x="3" y="5.5" width="18" height="13" rx="2.5"/><path d="M3 10h18M7 14.5h4"/>
    {%- when 'cross' -%}
