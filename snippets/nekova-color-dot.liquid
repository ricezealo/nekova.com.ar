{%- comment -%}
  Small color dot for a variant color name (product cards). Unknown names render nothing.
  Keep in sync with the color map of sections/nekova-product.liquid.
  @param {string} name - Color name, e.g. "Azul marino".
{%- endcomment -%}
{%- liquid
  assign dot_color = ''
  assign dot_handle = name | handleize
  case dot_handle
    when 'gris'
      assign dot_color = '#7b8287'
    when 'gris-claro'
      assign dot_color = '#b8bdc1'
    when 'gris-oscuro'
      assign dot_color = '#4b4f53'
    when 'azul-marino'
      assign dot_color = '#252b5c'
    when 'azul'
      assign dot_color = '#2f4f8a'
    when 'celeste'
      assign dot_color = '#8fb8d8'
    when 'negro'
      assign dot_color = '#1d1d1b'
    when 'blanco'
      assign dot_color = '#f4f3ef'
    when 'beige', 'crema'
      assign dot_color = '#d9c7a7'
    when 'naranja'
      assign dot_color = '#f26a1b'
    when 'verde', 'verde-menta'
      assign dot_color = '#9fd8c4'
    when 'lila', 'violeta'
      assign dot_color = '#b9a8e6'
    when 'rosa'
      assign dot_color = '#d8a1a8'
  endcase
-%}
{%- if dot_color != blank -%}
  <span class="nk-dot" style="background-color: {{ dot_color }};" title="{{ name | escape }}"><span class="visually-hidden">{{ name | escape }}</span></span>
{%- endif -%}
