{%- liquid
  assign contact_email = settings.nekova_email | default: shop.email
  assign whatsapp_digits = settings.nekova_whatsapp | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')' | remove: '.'
-%}

<section class="nk-about" aria-labelledby="NkAboutTitle-{{ section.id }}">
  <div class="nk-about-shell nk-about-hero">
    <p class="nk-about-eyebrow">Sobre Nekova</p>
    <h1 id="NkAboutTitle-{{ section.id }}">{{ section.settings.heading }}</h1>
    {%- if section.settings.intro != blank -%}
      <div class="nk-about-lead">{{ section.settings.intro }}</div>
    {%- endif -%}
  </div>

  <div class="nk-about-band">
    <div class="nk-about-shell">
      <ul class="nk-about-pillars" role="list">
        <li>
          <span class="nk-about-icon">{% render 'nekova-icon', icon: 'check' %}</span>
          <strong>Productos elegidos con criterio</strong>
          <p>Seleccionamos cada producto por su diseño, sus materiales y su utilidad real en el día a día. Empezamos por el cojín ergonómico en U.</p>
        </li>
        <li>
          <span class="nk-about-icon">{% render 'nekova-icon', icon: 'card' %}</span>
          <strong>Información clara</strong>
          <p>Precio, envío y condiciones a la vista antes de comprar. Sin letra chica ni sorpresas en el checkout.</p>
        </li>
        <li>
          <span class="nk-about-icon">{% render 'nekova-icon', icon: 'shield' %}</span>
          <strong>Atención de personas</strong>
          <p>Si tenés una duda antes o después de comprar, te responde nuestro equipo, no un robot.</p>
        </li>
      </ul>
    </div>
  </div>

  <div class="nk-about-shell nk-about-promise">
    <div>
      <p class="nk-about-eyebrow">Nuestro compromiso</p>
      <h2>Comprá con <span>tranquilidad</span></h2>
    </div>
    <ul class="nk-about-list" role="list">
      <li>{% render 'nekova-icon', icon: 'truck' %}<span><strong>Despacho en el día</strong> comprando antes de las 13 h; después, dentro de las 24 h.</span></li>
      <li>{% render 'nekova-icon', icon: 'return' %}<span><strong>10 días para devolverlo</strong> si no te convence, con el producto completo y en perfecto estado.</span></li>
      <li>{% render 'nekova-icon', icon: 'shield' %}<span><strong>60 días de garantía</strong> en nuestros productos.</span></li>
    </ul>
  </div>

  <div class="nk-about-shell">
    <div class="nk-about-cta">
      <div>
        <h2>¿Hablamos?</h2>
        <p>Escribinos por cualquier consulta sobre los productos, tu compra o un pedido.</p>
      </div>
      <div class="nk-about-actions">
        {%- if settings.nekova_whatsapp != blank -%}
          <a class="nk-about-button" href="https://wa.me/{{ whatsapp_digits }}?text={{ settings.nekova_whatsapp_message | default: 'Hola Nekova, tengo una consulta.' | url_encode }}" target="_blank" rel="noopener">Escribinos por WhatsApp</a>
        {%- endif -%}
        {%- if contact_email != blank -%}
          <a class="nk-about-button nk-about-button--ghost" href="mailto:{{ contact_email }}">{{ contact_email }}</a>
        {%- endif -%}
        <a class="nk-about-link" href="{{ routes.root_url }}">Ver el cojín ergonómico →</a>
      </div>
    </div>
  </div>
</section>

{% style %}
  .nk-about { background: var(--nekova-bg); color: var(--nekova-ink); font-family: var(--nekova-font-body); padding-bottom: 8rem; }
  .nk-about * { box-sizing: border-box; }
  .nk-about-shell { margin: 0 auto; max-width: 1280px; padding: 0 5rem; }
  .nk-about h1, .nk-about h2 { color: var(--nekova-ink); font-family: var(--nekova-font-heading); font-weight: var(--font-heading-weight); letter-spacing: -.02em; line-height: 1.12; margin: 0; }
  .nk-about-eyebrow { align-items: center; color: var(--nekova-accent); display: flex; font-size: 1.25rem; font-weight: 800; gap: 1rem; letter-spacing: .14em; margin: 0 0 1.6rem; text-transform: uppercase; }
  .nk-about-eyebrow::before { background: currentColor; border-radius: 2px; content: ''; height: 2px; width: 2.4rem; }
  .nk-about-hero { padding-bottom: 7rem; padding-top: 7rem; }
  .nk-about-hero h1 { font-size: clamp(3.4rem, 4.6vw, 5.6rem); max-width: 86rem; }
  .nk-about-hero h1 em, .nk-about-promise h2 span { color: var(--nekova-accent); font-style: normal; }
  .nk-about-lead { color: var(--nekova-muted); font-size: 1.8rem; line-height: 1.65; margin-top: 2.4rem; max-width: 70rem; }
  .nk-about-lead p { margin: 0 0 1.2rem; }
  .nk-about-band { background: var(--nekova-panel); padding: 7rem 0; }
  .nk-about-pillars { display: grid; gap: 2rem; grid-template-columns: repeat(3, minmax(0, 1fr)); list-style: none; margin: 0; padding: 0; }
  .nk-about-pillars li { background: var(--nekova-surface); border-radius: var(--nekova-radius-lg); padding: 3.2rem; }
  .nk-about-icon { align-items: center; background: var(--nekova-accent-soft); border-radius: 50%; color: var(--nekova-accent); display: flex; height: 5.2rem; justify-content: center; margin-bottom: 2.2rem; width: 5.2rem; }
  .nk-about-icon svg { height: 2.4rem; width: 2.4rem; }
  .nk-about-pillars strong { display: block; font-family: var(--nekova-font-heading); font-size: 1.9rem; font-weight: var(--font-heading-weight); margin-bottom: .6rem; }
  .nk-about-pillars p { color: var(--nekova-muted); font-size: 1.5rem; line-height: 1.6; margin: 0; }
  .nk-about-promise { align-items: center; display: grid; gap: 6rem; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); padding-bottom: 7rem; padding-top: 7rem; }
  .nk-about-promise h2 { font-size: clamp(3rem, 3.6vw, 4.4rem); }
  .nk-about-list { display: grid; gap: 1.6rem; list-style: none; margin: 0; padding: 0; }
  .nk-about-list li { align-items: flex-start; border-bottom: 1px solid var(--nekova-line); color: var(--nekova-muted); display: flex; font-size: 1.6rem; gap: 1.4rem; line-height: 1.55; padding-bottom: 1.6rem; }
  .nk-about-list strong { color: var(--nekova-ink); }
  .nk-about-list svg { color: var(--nekova-accent); flex: 0 0 auto; height: 2.6rem; width: 2.6rem; }
  .nk-about-cta { align-items: center; background: var(--nekova-ink); border-radius: var(--nekova-radius-lg); color: #fff; display: grid; gap: 3rem; grid-template-columns: minmax(0, 1fr) auto; padding: 4.8rem; }
  .nk-about .nk-about-cta h2 { color: #fff; font-size: clamp(2.8rem, 3vw, 3.6rem); margin-bottom: .8rem; }
  .nk-about-cta p { color: rgba(255, 255, 255, .75); font-size: 1.6rem; margin: 0; }
  .nk-about-actions { align-items: center; display: flex; flex-wrap: wrap; gap: 1.2rem; }
  .nk-about-button { align-items: center; background: var(--nekova-accent); border-radius: 1.2rem; color: var(--nekova-on-accent); display: inline-flex; font-size: 1.5rem; font-weight: 700; min-height: 5rem; padding: 0 2.4rem; text-decoration: none; transition: background .2s; }
  .nk-about-button:hover { background: var(--nekova-accent-strong); }
  .nk-about-button--ghost { background: transparent; border: 1px solid rgba(255, 255, 255, .35); }
  .nk-about-button--ghost:hover { background: rgba(255, 255, 255, .1); }
  .nk-about-link { color: #fff; font-size: 1.5rem; font-weight: 700; text-underline-offset: .2em; width: 100%; }
  .nk-about a:focus-visible { outline: 2px solid var(--nekova-accent); outline-offset: 3px; }
  @media screen and (max-width: 990px) {
    .nk-about-shell { padding: 0 2.4rem; }
    .nk-about-pillars { grid-template-columns: 1fr; }
    .nk-about-promise, .nk-about-cta { gap: 2.8rem; grid-template-columns: 1fr; }
  }
  @media screen and (max-width: 600px) {
    .nk-about-shell { padding: 0 1.6rem; }
    .nk-about-hero { padding-bottom: 4.8rem; padding-top: 4.8rem; }
    .nk-about-band { padding: 4.8rem 0; }
    .nk-about-pillars li { padding: 2.4rem; }
    .nk-about-promise { padding-bottom: 4.8rem; padding-top: 4.8rem; }
    .nk-about-cta { padding: 3.2rem 2.4rem; }
    .nk-about-button { justify-content: center; width: 100%; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Nekova · sobre nosotros",
  "class": "nekova-about-section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título",
      "default": "Objetos para sentarte, trabajar y descansar <em>mejor</em>"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Texto de presentación",
      "default": "<p>Nekova nace con una idea simple: que las horas que pasás sentado, trabajando o descansando sean más cómodas.</p><p>Elegimos productos de ergonomía y bienestar que resuelven molestias cotidianas, y los acompañamos con información clara y atención cercana.</p>"
    }
  ],
  "presets": [
    {
      "name": "Nekova · sobre nosotros"
    }
  ]
}
{% endschema %}
