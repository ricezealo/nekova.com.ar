<section class="nekova-contact-intro" aria-labelledby="NekovaContactPageTitle-{{ section.id }}">
  <div class="nekova-contact-intro__inner">
    <p class="premium-eyebrow"><span></span> NEKOVA · HOGAR Y OFICINA</p>
    <h1 id="NekovaContactPageTitle-{{ section.id }}">Estamos para<br><em>escucharte.</em></h1>
    <p>¿Tenés una consulta sobre un producto, una compra o un pedido? Completá el formulario y nuestro equipo se pondrá en contacto con vos.</p>
    {% render 'nekova-social-icons', class: 'nekova-contact-social' %}
  </div>
</section>

{% style %}
  .nekova-contact-intro {
    --contact-bg: #111310;
    --contact-ink: #f1eee6;
    --contact-muted: #aaa99f;
    --contact-accent: #c9a878;
    background: var(--contact-bg);
    color: var(--contact-ink);
    padding: 7rem 5.5% 4rem;
  }
  .nekova-contact-intro__inner { margin: 0 auto; max-width: 1120px; }
  .nekova-contact-intro .premium-eyebrow { color: var(--contact-accent); font-size: 1.05rem; letter-spacing: .18em; }
  .nekova-contact-intro .premium-eyebrow span { background: var(--contact-accent); display: inline-block; height: 1px; width: 2.6rem; }
  .nekova-contact-intro h1 { color: var(--contact-ink); font: 400 clamp(5rem, 8vw, 9rem)/.98 Georgia, 'Times New Roman', serif; letter-spacing: -.05em; margin: 2.4rem 0 1.5rem; }
  .nekova-contact-intro h1 em { color: var(--contact-accent); font-weight: 400; }
  .nekova-contact-intro__inner > p:last-child { color: var(--contact-muted); font-size: 1.35rem; line-height: 1.8; max-width: 62rem; }
  @media screen and (max-width: 600px) {
    .nekova-contact-intro { padding: 4rem 2rem 2rem; }
    .nekova-contact-intro h1 { font-size: clamp(4.5rem, 16vw, 6rem); }
  }
{% endstyle %}

{% schema %}
{
  "name": "Nekova · contacto",
  "settings": [],
  "presets": [
    {
      "name": "Nekova · contacto"
    }
  ]
}
{% endschema %}
