  .premium-landing .rte table { display: block; max-width: 100%; overflow-x: auto; }
  .premium-lightbox { background: rgba(15, 16, 14, .98); border: 0; color: var(--premium-ink); height: 100dvh; margin: 0; max-height: none; max-width: none; overflow: hidden; padding: 0; position: fixed; width: 100vw; }
