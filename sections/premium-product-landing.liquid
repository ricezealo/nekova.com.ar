    .premium-landing { padding-bottom: 4rem; }
    .premium-hero { min-height: auto; padding: 4rem 0 3rem; }
    .premium-copy h1 { font-size: clamp(4.4rem, 15vw, 6.5rem); }
    .premium-product-name { font-size: 1.2rem; }
    .premium-intro { font-size: 1.25rem; }
    .premium-gallery-main { height: 118vw; min-height: 36rem; }
    .premium-story { gap: 3.5rem; grid-template-columns: 1fr; padding: 7rem 0; }
    .premium-story-image { height: 110vw; max-height: 48rem; }
    .premium-story h2, .premium-section-heading h2, .premium-specs h2 { font-size: 4.6rem; }
    .premium-benefits, .premium-specs, .premium-faq { padding: 5.5rem 0; }
    .premium-section-heading { margin-bottom: 3rem; }
    .premium-benefit-grid { grid-template-columns: 1fr 1fr; }
    .premium-benefit-grid article { min-height: 19rem; padding: 1.5rem; }
    .premium-benefit-grid h3 { font-size: 1.75rem; margin-top: 3rem; }
    .premium-benefit-grid p { font-size: 1.05rem; }
    .premium-spec-list div { gap: 1rem; }
    .premium-spec-list dt, .premium-spec-list dd { font-size: 1rem; }
    .premium-packaging { gap: 2.5rem; grid-template-columns: 1fr; padding: 6rem 0; }
    .premium-packaging-mark { height: 7rem; width: 7rem; }
    .premium-packaging ul { grid-column: 1; }
    .premium-faq .premium-section-heading h2 { font-size: 4rem; }
    .premium-faq-list summary { font-size: 1.45rem; }
    .premium-final-cta { margin: 0; padding: 5rem 1.5rem; }
    .premium-final-cta h2 { font-size: 5rem; }
  }
