{% style %}
  .premium-landing {
    --premium-bg: #111310;
    --premium-panel: #191b17;
    --premium-panel-soft: #20221d;
    --premium-ink: #f1eee6;
    --premium-muted: #aaa99f;
    --premium-accent: #c9a878;
    --premium-line: rgba(241, 238, 230, .15);
    background: var(--premium-bg);
    color: var(--premium-ink);
    font-family: Arial, Helvetica, sans-serif;
    padding: 0 0 8rem;
  }
  .premium-landing--comfort {
    --premium-bg: #f5f1e9;
    --premium-panel: #ebe5da;
    --premium-panel-soft: #e3dccf;
    --premium-ink: #292a25;
    --premium-muted: #5f6059;
    --premium-accent: #806545;
    --premium-line: rgba(41, 42, 37, .18);
  }
  .premium-landing--comfort .premium-gallery-main { aspect-ratio: 1; background: #e9e3d9; }
  .premium-landing--comfort .premium-gallery-main img { object-fit: contain; padding: 3%; }
  .premium-landing--comfort .premium-gallery-thumbs button { background: #e9e3d9; }
  .premium-landing--comfort .premium-story-image { background: #e9e3d9; }
  .premium-landing--comfort .premium-photo-story img { background: #e9e3d9; }
  .premium-landing--comfort .premium-benefit-grid article { background: #f5f1e9; }
  .premium-landing--comfort .premium-final-cta { border: 1px solid var(--premium-line); }
  .premium-landing * { box-sizing: border-box; }
  .premium-shell { max-width: 1440px; margin: 0 auto; padding: 0 5.5%; }
  .premium-hero { min-height: 78vh; display: grid; grid-template-columns: .88fr 1.12fr; align-items: center; gap: 8%; padding: 7rem 0 6rem; }
  .premium-copy { max-width: 490px; padding: 2rem 0; }
  .premium-eyebrow, .premium-edition { margin: 0; color: var(--premium-accent); font-size: 1.05rem; font-weight: 600; letter-spacing: .18em; line-height: 1.6; }
  .premium-eyebrow { display: flex; align-items: center; gap: 1rem; }
  .premium-eyebrow span { width: 2.6rem; height: 1px; background: var(--premium-accent); display: inline-block; }
  .premium-edition { color: var(--premium-muted); font-size: .9rem; letter-spacing: .16em; margin-top: 4.2rem; }
  .premium-copy h1, .premium-story h2, .premium-section-heading h2, .premium-specs h2, .premium-packaging h2, .premium-final-cta h2 {
    color: var(--premium-ink); font-family: Georgia, 'Times New Roman', serif; font-size: clamp(4rem, 6vw, 7.4rem);
    font-weight: 400; letter-spacing: -.045em; line-height: .99; margin: 1.8rem 0 1.2rem;
  }
  .premium-copy h1 { font-size: clamp(4.2rem, 6.5vw, 7.8rem); }
  .premium-copy h1 em, .premium-story h2 em, .premium-section-heading h2 em, .premium-specs h2 em, .premium-final-cta h2 em { color: var(--premium-accent); font-weight: 400; }
  .premium-product-name { color: var(--premium-ink); font-size: 1.35rem; letter-spacing: .025em; margin: 2.2rem 0 .8rem; }
  .premium-intro, .premium-story-copy > p:not(.premium-eyebrow), .premium-specs-intro > p:not(.premium-eyebrow), .premium-packaging > div:first-child > p:not(.premium-eyebrow) {
    color: var(--premium-muted); font-size: 1.45rem; line-height: 1.8; max-width: 48rem;
  }
  .premium-price { display: flex; flex-wrap: wrap; align-items: center; gap: .8rem 1.2rem; margin: 2.4rem 0 .7rem; }
  .premium-price-current { color: var(--premium-ink); font-family: Georgia, 'Times New Roman', serif; font-size: 2.8rem; }
  .premium-price-current small { color: var(--premium-muted); font: 500 .95rem Arial, sans-serif; letter-spacing: .1em; }
  .premium-price-was { color: #8c8d84; font-size: 1.2rem; text-decoration: line-through; }
  .premium-discount { border: 1px solid var(--premium-accent); color: var(--premium-accent); font-size: 1rem; letter-spacing: .08em; padding: .65rem .8rem; }
  .premium-launch-note, .premium-select-note { color: var(--premium-muted); font-size: 1.1rem; margin: 0 0 2rem; }
  .premium-buy-form { margin: 2.2rem 0 0; }
  .premium-buy-button { align-items: center; background: var(--premium-accent); border: 1px solid var(--premium-accent); color: #151510; cursor: pointer; display: flex; font: 600 1.2rem Arial, sans-serif; justify-content: space-between; letter-spacing: .04em; max-width: 44rem; min-height: 5.8rem; padding: 0 2rem; text-decoration: none; transition: background .2s, color .2s; width: 100%; }
  .premium-buy-button:hover { background: transparent; color: var(--premium-accent); }
  .premium-buy-button:disabled { cursor: not-allowed; opacity: .55; }
  .premium-stock-notice { background: var(--premium-panel); margin-top: 2.2rem; max-width: 48rem; padding: 2rem; }
  .premium-stock-status { color: var(--premium-accent); font-size: .9rem; letter-spacing: .16em; }
  .premium-stock-notice > p { color: var(--premium-muted); font-size: 1.1rem; line-height: 1.7; }
  .premium-stock-form > label:first-of-type { color: var(--premium-ink); display: block; font-size: 1rem; margin-bottom: .7rem; }
  .premium-stock-input-row { display: flex; gap: .8rem; }
  .premium-stock-input-row input { background: var(--premium-bg); border: 1px solid var(--premium-line); color: var(--premium-ink); flex: 1; min-width: 0; padding: 1.2rem; }
  .premium-stock-submit { background: var(--premium-accent); border: 1px solid var(--premium-accent); color: #151510; cursor: pointer; font-weight: 600; padding: 0 1.6rem; }
  .premium-stock-consent { align-items: flex-start; color: var(--premium-muted); display: flex; font-size: .95rem; gap: .8rem; line-height: 1.5; margin-top: 1.2rem; }
  .premium-stock-consent input { accent-color: var(--premium-accent); margin-top: .2rem; }
  .premium-stock-success { color: var(--premium-accent); line-height: 1.7; }
  .premium-stock-error { color: #ffb4a9; line-height: 1.7; }
  .premium-assurances { color: var(--premium-muted); display: flex; flex-wrap: wrap; font-size: .95rem; gap: .6rem 1.8rem; letter-spacing: .05em; margin-top: 1.8rem; }
  .premium-assurances span::before { color: var(--premium-accent); content: '✓'; margin-right: .7rem; }
  .premium-policy-note { color: var(--premium-muted); font-size: 1rem; line-height: 1.7; margin: 1.4rem 0 0; max-width: 48rem; }
  .premium-policy-note a { color: var(--premium-accent); text-underline-offset: .2em; }
  .premium-gallery { min-width: 0; }
  .premium-gallery-main { aspect-ratio: 4 / 5; background: #292823; height: auto; min-height: 0; overflow: hidden; position: relative; touch-action: pan-y; }
  .premium-gallery-open { background: transparent; border: 0; cursor: zoom-in; display: block; height: 100%; inset: 0; padding: 0; position: absolute; width: 100%; }
  .premium-gallery-main img { display: block; height: 100%; object-fit: cover; object-position: center; width: 100%; }
  .premium-gallery-control { align-items: center; background: linear-gradient(90deg, rgba(17, 19, 16, .4), rgba(17, 19, 16, 0)); border: 0; color: #f4f1e8; cursor: pointer; display: flex; height: 100%; justify-content: center; padding: 0; position: absolute; top: 0; transition: background .2s, color .2s; width: 4.8rem; z-index: 2; }
  .premium-gallery-control:hover { color: var(--premium-accent); }
  .premium-gallery-control:focus-visible { outline: 2px solid var(--premium-accent); outline-offset: -3px; }
  .premium-gallery-control span { font-size: 2.4rem; line-height: 1; text-shadow: 0 1px 8px rgba(0, 0, 0, .5); }
  .premium-gallery-previous { background: linear-gradient(90deg, rgba(17, 19, 16, .46), rgba(17, 19, 16, 0)); box-shadow: inset -1px 0 rgba(255, 255, 255, .12); left: 0; }
  .premium-gallery-next { background: linear-gradient(270deg, rgba(17, 19, 16, .46), rgba(17, 19, 16, 0)); box-shadow: inset 1px 0 rgba(255, 255, 255, .12); right: 0; }
  .premium-image-index { background: rgba(17, 19, 16, .75); bottom: 1.5rem; color: var(--premium-ink); font-size: .9rem; letter-spacing: .17em; padding: .9rem 1.2rem; position: absolute; right: 1.5rem; }
  .premium-gallery-thumbs { display: grid; gap: .8rem; grid-template-columns: repeat(8, minmax(0, 1fr)); margin-top: .8rem; }
  .premium-gallery-thumbs button { aspect-ratio: 1; background: var(--premium-panel); border: 1px solid transparent; cursor: pointer; opacity: .65; overflow: hidden; padding: 0; }
  .premium-gallery-thumbs button.is-active, .premium-gallery-thumbs button:hover { border-color: var(--premium-accent); opacity: 1; }
  .premium-gallery-thumbs img { height: 100%; object-fit: cover; width: 100%; }
  .premium-copy, .premium-story > *, .premium-benefit-grid > *, .premium-specs > *, .premium-faq > *, .premium-reviews > * { min-width: 0; }
  .premium-landing .rte { max-width: 100%; overflow-wrap: anywhere; }
