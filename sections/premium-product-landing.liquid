                <img src="{{ image_file | asset_url }}" alt="" loading="lazy">
              </button>
            {% endfor %}
          {% elsif is_ergonomic_cushion %}
            {% assign cushion_gallery_images = 'product-media-cojin-ergonomico-07.jpg,product-media-cojin-ergonomico-01.jpg,product-media-cojin-ergonomico-02.jpg,product-media-cojin-ergonomico-03.jpg,product-media-cojin-ergonomico-04.jpg,product-media-cojin-ergonomico-05.jpg,product-media-cojin-ergonomico-06.jpg,product-media-cojin-ergonomico-08.jpg' | split: ',' %}
            {% for image_file in cushion_gallery_images %}
              <button class="{% if forloop.first %}is-active{% endif %}" type="button" aria-label="Ver cojín ergonómico, imagen {{ forloop.index }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" data-premium-image="{{ image_file | asset_url }}" data-premium-alt="Cojín ergonómico de doble capa, imagen {{ forloop.index }}">
                <img src="{{ image_file | asset_url }}" alt="" loading="lazy">
