{%- liquid
  assign featured_product = product | default: section.settings.product
  assign current_price = featured_product.price
  assign selected_variant = featured_product.selected_or_first_available_variant
  assign original_price = selected_variant.compare_at_price | default: featured_product.compare_at_price
  assign has_discount = false
  if original_price > current_price
    assign has_discount = true
    assign discount_amount = original_price | minus: current_price
    assign discount_percent = discount_amount | times: 100.0 | divided_by: original_price | round
  endif
  assign is_reading_stand = false
  if featured_product.handle == 'atril-madera-giratorio-360'
    assign is_reading_stand = true
  endif
  assign is_k25_light = false
  if featured_product.handle == 'lampara-video-portatil-k25-rgb'
    assign is_k25_light = true
  endif
  assign is_ergonomic_cushion = false
  if featured_product.handle == 'cojin-ergonomico-doble-capa'
    assign is_ergonomic_cushion = true
  endif
  assign product_type_downcase = featured_product.type | downcase
  assign is_comfort_product = false
  if featured_product.handle contains 'cojin' or featured_product.handle contains 'almohada' or product_type_downcase contains 'cojin' or product_type_downcase contains 'almohada' or product_type_downcase contains 'descanso' or featured_product.tags contains 'confort' or featured_product.tags contains 'cojines' or featured_product.tags contains 'almohadas'
    assign is_comfort_product = true
  endif
  assign stock_form_id = 'BackInStockForm-' | append: section.id
-%}

{{ 'premium-product-landing.js' | asset_url | script_tag }}

<section class="premium-landing section-{{ section.id }}{% if is_comfort_product %} premium-landing--comfort{% endif %}" aria-labelledby="PremiumTitle-{{ section.id }}">
  <div class="premium-shell">
    <div class="premium-hero">
      <div class="premium-copy">
        <p class="premium-eyebrow"><span></span> NEKOVA · CASA, TRABAJO Y CONFORT</p>
        <p class="premium-edition">OBJETOS PARA TODOS TUS ESPACIOS &nbsp; / &nbsp; {{ featured_product.type | default: 'COLECCIÓN NEKOVA' }}</p>
        <h1 id="PremiumTitle-{{ section.id }}">{{ featured_product.title | default: section.settings.heading | escape }}</h1>
        <p class="premium-product-name">{% if is_reading_stand %}Diseño funcional para leer, estudiar y crear.{% elsif is_k25_light %}Luz creativa, lista para llevar.{% elsif is_ergonomic_cushion %}Confort ergonómico para tus horas sentado.{% else %}Diseño pensado para acompañar tu día.{% endif %}</p>
        <div class="premium-intro">{% if is_reading_stand %}Soporte plegable de madera MDF, ajustable y giratorio 360°, para laptop, libros y tabletas. Incluye una ranura de almacenamiento y un clip elevable para páginas.{% elsif is_k25_light %}Una luz RGB compacta de 25 W para fotografía, video, streaming y creación de contenido. Ajustá el color, la temperatura y el brillo para darle forma a cada escena.{% elsif is_ergonomic_cushion %}Dos capas de espuma, una ranura ergonómica en U y una funda transpirable y extraíble: comodidad práctica para el trabajo, los viajes y el uso diario.{% else %}{{ featured_product.description | strip_html | truncatewords: 34 }}{% endif %}</div>

        <div class="premium-price" aria-label="Precio del producto">
          <span class="premium-price-current">{{ current_price | money_without_trailing_zeros }} <small>ARS</small></span>
          {% if has_discount %}
            <span class="premium-price-was">{{ original_price | money_without_trailing_zeros }} ARS</span>
            <span class="premium-discount">{{ discount_percent }}% OFF</span>
          {% endif %}
        </div>
        {% if has_discount %}
          <p class="premium-launch-note">Precio especial · Ahorrás {{ discount_amount | money_without_trailing_zeros }} ARS</p>
        {% endif %}

        {%- if featured_product != blank and featured_product.available -%}
          {% form 'product', featured_product, class: 'premium-buy-form' %}
            <input type="hidden" name="id" value="{{ selected_variant.id }}">
            <input type="hidden" name="quantity" value="1">
            <button class="premium-buy-button" type="submit" name="add" {% unless featured_product.available %}disabled{% endunless %}>
              <span>{% if featured_product.available %}Agregar al carrito{% else %}Producto agotado{% endif %}</span>
              <span aria-hidden="true">↗</span>
            </button>
          {% endform %}
        {%- elsif featured_product != blank -%}
          <div class="premium-stock-notice">
            <span class="premium-stock-status">PRÓXIMAMENTE</span>
            <p>Dejanos tu email y te avisaremos cuando este producto esté disponible.</p>
            {% form 'customer', id: stock_form_id, class: 'premium-stock-form' %}
              {% if form.posted_successfully? or stock_notification_registered %}
                <p class="premium-stock-success" role="status">¡Listo! Registramos tu email para avisarte sobre la disponibilidad de este producto.</p>
              {% else %}
                {% if form.errors %}
                  <p class="premium-stock-error" role="alert">No pudimos registrar tu email. Revisá el dato e intentá nuevamente.</p>
                {% endif %}
                <input type="hidden" name="contact[tags]" value="back-in-stock, back-in-stock-{{ featured_product.handle }}">
                <label for="BackInStockEmail-{{ section.id }}">Tu correo electrónico</label>
                <div class="premium-stock-input-row">
                  <input id="BackInStockEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" placeholder="nombre@correo.com" required>
                  <button type="submit" class="premium-stock-submit">Avisarme</button>
                </div>
                <label class="premium-stock-consent" for="BackInStockConsent-{{ section.id }}">
                  <input id="BackInStockConsent-{{ section.id }}" type="checkbox" name="contact[accepts_marketing]" value="true" required>
                  <span>Acepto recibir por email un aviso cuando este producto esté disponible.</span>
                </label>
              {% endif %}
            {% endform %}
          </div>
        {%- else -%}
          <a class="premium-buy-button" href="{{ featured_product.url }}">
            <span>Ver producto</span>
            <span aria-hidden="true">↗</span>
          </a>
          <p class="premium-select-note">Elegí este objeto para descubrir todos sus detalles.</p>
        {%- endif -%}
        <div class="premium-assurances">
          {% if is_k25_light %}
            <span>25 W RGB</span><span>Batería 3300 mAh</span><span>Diseño portátil</span>
          {% elsif is_ergonomic_cushion %}
            <span>Relleno de doble capa</span><span>Funda extraíble</span><span>Diseño ergonómico</span>
          {% else %}
            <span>Diseño funcional</span><span>Madera MDF</span><span>Uso diario</span>
          {% endif %}
        </div>
        <p class="premium-policy-note">60 días de garantía. El costo de envío y los medios de pago se confirman antes de finalizar tu compra. <a href="/#NekovaFaqTitle-home_showcase">Ver condiciones de compra</a>.</p>
      </div>

