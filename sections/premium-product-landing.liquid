{%- liquid
  assign featured_product = product | default: section.settings.product
  assign current_price = featured_product.price
  assign selected_variant = featured_product.selected_or_first_available_variant
  assign original_price = selected_variant.compare_at_price | default: featured_product.compare_at_price
  assign has_discount = false
  if original_price > current_price
    assign has_discount = true
    assign discount_amount = original_price | minus: current_price
    assign discount_percent = discount_amount | times: 100.0 | divided_by: original_price | round
  endif
  assign is_reading_stand = false
  if featured_product.handle == 'atril-madera-giratorio-360'
    assign is_reading_stand = true
  endif
  assign is_k25_light = false
  if featured_product.handle == 'lampara-video-portatil-k25-rgb'
    assign is_k25_light = true
  endif
  assign is_ergonomic_cushion = false
  if featured_product.handle == 'cojin-ergonomico-doble-capa'
    assign is_ergonomic_cushion = true
  endif
  assign is_orthopedic_cushion = false
  if featured_product.handle == 'cojin-ortopedico-u'
    assign is_orthopedic_cushion = true
  endif
  assign product_video = ''
  assign product_video_poster = ''
  if is_k25_light
    assign product_video = 'k25-video-light.mp4'
    assign product_video_poster = 'product-media-k25-video-light-poster.jpg'
  elsif is_orthopedic_cushion
    assign product_video = 'cojin-ortopedico.mp4'
    assign product_video_poster = 'product-media-cojin-ortopedico-poster.jpg'
  endif
  assign has_variant_choice = false
  if featured_product.has_only_default_variant == false and featured_product.variants.size > 1
    assign has_variant_choice = true
    assign variant_option_name = featured_product.options.first | default: 'Variante'
  endif
  assign product_type_downcase = featured_product.type | downcase
  assign is_comfort_product = false
  if featured_product.handle contains 'cojin' or featured_product.handle contains 'almohada' or product_type_downcase contains 'cojin' or product_type_downcase contains 'almohada' or product_type_downcase contains 'descanso' or featured_product.tags contains 'confort' or featured_product.tags contains 'cojines' or featured_product.tags contains 'almohadas'
    assign is_comfort_product = true
  endif
  assign stock_form_id = 'BackInStockForm-' | append: section.id
-%}

<script src="{{ 'premium-product-landing.js' | asset_url }}" defer="defer"></script>

<section class="premium-landing section-{{ section.id }}" aria-labelledby="PremiumTitle-{{ section.id }}">
  <div class="premium-shell">
    <div class="premium-hero">
      <div class="premium-copy">
        <p class="premium-eyebrow"><span></span> NEKOVA · ERGONOMÍA Y BIENESTAR</p>
        {%- if section.settings.launch_heading != blank -%}
          <h1 id="PremiumTitle-{{ section.id }}">{{ section.settings.launch_heading }}</h1>
          <p class="premium-product-title">{{ featured_product.title | escape }}</p>
        {%- else -%}
          <p class="premium-edition">CONFORT PARA CADA DÍA &nbsp; / &nbsp; {{ featured_product.type | default: 'NEKOVA' }}</p>
          <h1 id="PremiumTitle-{{ section.id }}">{{ featured_product.title | default: section.settings.heading | escape }}</h1>
        {%- endif -%}
        <p class="premium-product-name">{% if is_reading_stand %}Diseño funcional para leer, estudiar y crear.{% elsif is_k25_light %}Luz creativa, lista para llevar.{% elsif is_ergonomic_cushion %}Confort ergonómico para tus horas sentado.{% elsif is_orthopedic_cushion %}Un apoyo envolvente para tus horas sentado.{% else %}Diseño pensado para acompañar tu día.{% endif %}</p>
        <div class="premium-intro">{% if is_reading_stand %}Soporte plegable de madera MDF, ajustable y giratorio 360°, para laptop, libros y tabletas. Incluye una ranura de almacenamiento y un clip elevable para páginas.{% elsif is_k25_light %}Una luz RGB compacta de 25 W para fotografía, video, streaming y creación de contenido. Ajustá el color, la temperatura y el brillo para darle forma a cada escena.{% elsif is_ergonomic_cushion %}Dos capas de espuma, una ranura ergonómica en U y una funda transpirable y extraíble: comodidad práctica para el trabajo, los viajes y el uso diario.{% elsif is_orthopedic_cushion %}Espuma viscoelástica de recuperación lenta, una ranura en U que libera la zona del coxis y laterales elevados que acompañan tu postura. Con funda transpirable y extraíble, para la oficina, el auto o tu casa.{% else %}{{ featured_product.description | strip_html | truncatewords: 34 }}{% endif %}</div>

        <div class="premium-price" aria-label="Precio del producto">
          <span class="premium-price-current">{{ current_price | money_without_trailing_zeros }} <small>ARS</small></span>
          {% if has_discount %}
            <span class="premium-price-was">{{ original_price | money_without_trailing_zeros }} ARS</span>
            <span class="premium-discount">{{ discount_percent }}% OFF</span>
          {% endif %}
        </div>
        {% if has_discount %}
          <p class="premium-launch-note">Precio especial · Ahorrás {{ discount_amount | money_without_trailing_zeros }} ARS</p>
        {% endif %}

        {%- if featured_product != blank and featured_product.available -%}
          {% form 'product', featured_product, class: 'premium-buy-form' %}
            {%- if has_variant_choice -%}
              {%- assign variant_option_handle = variant_option_name | handleize -%}
              {%- assign is_color_option = false -%}
              {%- if variant_option_handle == 'color' or variant_option_handle == 'colour' or variant_option_handle == 'colores' -%}
                {%- assign is_color_option = true -%}
              {%- endif -%}
              <fieldset class="premium-variant-picker{% if is_color_option %} premium-variant-picker--swatches{% endif %}" id="PremiumVariants-{{ section.id }}" data-premium-variant-picker>
                <legend>{{ variant_option_name | escape }}<span aria-hidden="true"> · <span data-premium-variant-label>{{ selected_variant.title | escape }}</span></span></legend>
                <div class="premium-variant-options">
                  {%- for variant in featured_product.variants -%}
                    {%- liquid
                      assign variant_image = ''
                      if is_orthopedic_cushion
                        assign variant_title_handle = variant.title | handleize
                        if variant_title_handle contains 'azul'
                          assign variant_image = 'product-media-cojin-ortopedico-02.jpg' | asset_url
                        else
                          assign variant_image = 'product-media-cojin-ortopedico-01.jpg' | asset_url
                        endif
                      elsif variant.featured_media
                        assign variant_image = variant.featured_media | image_url: width: 1800
                      endif

                      assign swatch_color = ''
                      assign swatch_image = ''
                      if is_color_option
                        for option_value in featured_product.options_with_values.first.values
                          assign option_value_name = option_value.name | default: option_value
                          if option_value_name == variant.option1
                            assign swatch_color = option_value.swatch.color
                            if option_value.swatch.image
                              assign swatch_image = option_value.swatch.image | image_url: width: 80
                            endif
                          endif
                        endfor
                        # Fallback when the Shopify option value has no swatch: product colors by name.
                        if swatch_color == blank and swatch_image == blank
                          assign variant_color_handle = variant.option1 | handleize
                          case variant_color_handle
                            when 'gris'
                              assign swatch_color = '#7b8287'
                            when 'gris-claro'
                              assign swatch_color = '#b8bdc1'
                            when 'gris-oscuro'
                              assign swatch_color = '#4b4f53'
                            when 'azul-marino'
                              assign swatch_color = '#252b5c'
                            when 'azul'
                              assign swatch_color = '#2f4f8a'
                            when 'celeste'
                              assign swatch_color = '#8fb8d8'
                            when 'negro'
                              assign swatch_color = '#1d1d1b'
                            when 'blanco'
                              assign swatch_color = '#f4f3ef'
                            when 'beige', 'crema'
                              assign swatch_color = '#d9c7a7'
                            when 'marron', 'cafe', 'madera'
                              assign swatch_color = '#7a5638'
                            when 'verde'
                              assign swatch_color = '#4d6b4a'
                            when 'rojo'
                              assign swatch_color = '#a83232'
                            when 'rosa'
                              assign swatch_color = '#d8a1a8'
                          endcase
                        endif
                      endif
                      assign has_swatch = false
                      if swatch_color != blank or swatch_image != blank
                        assign has_swatch = true
                      endif
                    -%}
                    <label class="premium-variant-option">
                      <input type="radio" name="id" value="{{ variant.id }}" data-variant-title="{{ variant.title | escape }}"{% if variant_image != blank %} data-variant-image="{{ variant_image }}"{% endif %}{% if variant.id == selected_variant.id %} checked{% endif %}{% unless variant.available %} disabled{% endunless %}>
                      {%- if has_swatch -%}
                        <span class="premium-variant-swatch" style="{% if swatch_image != blank %}background-image: url('{{ swatch_image }}');{% elsif swatch_color != blank %}background-color: {{ swatch_color }};{% endif %}" aria-hidden="true"></span>
                        <span class="premium-variant-tooltip">{{ variant.title | escape }}{% unless variant.available %} · Agotado{% endunless %}</span>
                      {%- else -%}
                        <span class="premium-variant-pill">{{ variant.title | escape }}{% unless variant.available %} · Agotado{% endunless %}</span>
                      {%- endif -%}
                    </label>
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- else -%}
              <input type="hidden" name="id" value="{{ selected_variant.id }}">
            {%- endif -%}
            <input type="hidden" name="quantity" value="1">
            <button class="premium-buy-button" type="submit" name="add" {% unless featured_product.available %}disabled{% endunless %}>
              <span>{% if featured_product.available %}Agregar al carrito{% else %}Producto agotado{% endif %}</span>
              <span aria-hidden="true">↗</span>
            </button>
          {% endform %}
        {%- elsif featured_product != blank -%}
          <div class="premium-stock-notice">
            <span class="premium-stock-status">PRÓXIMAMENTE</span>
            <p>Dejanos tu email y te avisaremos cuando este producto esté disponible.</p>
            {% form 'customer', id: stock_form_id, class: 'premium-stock-form' %}
              {% if form.posted_successfully? or stock_notification_registered %}
                <p class="premium-stock-success" role="status">¡Listo! Registramos tu email para avisarte sobre la disponibilidad de este producto.</p>
              {% else %}
                {% if form.errors %}
                  <p class="premium-stock-error" role="alert">No pudimos registrar tu email. Revisá el dato e intentá nuevamente.</p>
                {% endif %}
                <input type="hidden" name="contact[tags]" value="back-in-stock, back-in-stock-{{ featured_product.handle }}">
                <label for="BackInStockEmail-{{ section.id }}">Tu correo electrónico</label>
                <div class="premium-stock-input-row">
                  <input id="BackInStockEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" placeholder="nombre@correo.com" required>
                  <button type="submit" class="premium-stock-submit">Avisarme</button>
                </div>
                <label class="premium-stock-consent" for="BackInStockConsent-{{ section.id }}">
                  <input id="BackInStockConsent-{{ section.id }}" type="checkbox" name="contact[accepts_marketing]" value="true" required>
                  <span>Acepto recibir por email un aviso cuando este producto esté disponible.</span>
                </label>
              {% endif %}
            {% endform %}
          </div>
        {%- else -%}
          <a class="premium-buy-button" href="{{ featured_product.url }}">
            <span>Ver producto</span>
            <span aria-hidden="true">↗</span>
          </a>
          <p class="premium-select-note">Elegí este objeto para descubrir todos sus detalles.</p>
        {%- endif -%}
        <div class="premium-assurances">
          {% if is_k25_light %}
            <span>25 W RGB</span><span>Batería 3300 mAh</span><span>Diseño portátil</span>
          {% elsif is_ergonomic_cushion %}
            <span>Relleno de doble capa</span><span>Funda extraíble</span><span>Diseño ergonómico</span>
          {% elsif is_orthopedic_cushion %}
            <span>Espuma viscoelástica</span><span>Funda extraíble</span><span>Ranura en U</span>
          {% elsif is_reading_stand %}
            <span>Diseño funcional</span><span>Madera MDF</span><span>Uso diario</span>
          {% else %}
            <span>Diseño funcional</span><span>Uso diario</span>
          {% endif %}
        </div>
        <p class="premium-policy-note">60 días de garantía. El costo de envío y los medios de pago se confirman antes de finalizar tu compra. <a href="#PremiumFaq-{{ section.id }}">Ver condiciones de compra</a>.</p>
      </div>

      <div class="premium-gallery" data-premium-gallery>
        <div class="premium-gallery-main">
          <button class="premium-gallery-open" type="button" aria-label="Ampliar imagen del producto" data-gallery-open>
          {% if is_reading_stand %}
            <img
              src="{{ 'product-media-Hb5f1ee0a42944e8da27b90df6e3ed1877.jpg' | asset_url }}"
              alt="Atril de madera ajustable para laptop, libros y tabletas"
              width="1200"
              height="1500"
              fetchpriority="high"
              data-premium-main-image
            >
          {% elsif is_k25_light %}
            <img
              src="{{ 'product-media-k25-video-light-02.jpg' | asset_url }}"
              alt="Mini lámpara de video K25 RGB portátil de 25 W"
              width="1200"
              height="1500"
              fetchpriority="high"
              data-premium-main-image
            >
          {% elsif is_ergonomic_cushion %}
            <img
              src="{{ 'product-media-cojin-ergonomico-07.jpg' | asset_url }}"
              alt="Cojín ergonómico de doble capa con malla transpirable y ranura central en U"
              width="1200"
              height="1200"
              fetchpriority="high"
              data-premium-main-image
            >
          {% elsif is_orthopedic_cushion %}
            <img
              src="{{ 'product-media-cojin-ortopedico-01.jpg' | asset_url }}"
              alt="Cojín ergonómico en U de espuma viscoelástica, color gris"
              width="1200"
              height="1200"
              fetchpriority="high"
              data-premium-main-image
            >
          {% elsif featured_product.featured_image %}
            <img src="{{ featured_product.featured_image | image_url: width: 1600 }}" alt="{{ featured_product.featured_image.alt | default: featured_product.title | escape }}" fetchpriority="high" data-premium-main-image            >
          {% endif %}
          </button>
          <button class="premium-gallery-control premium-gallery-previous" type="button" aria-label="Ver imagen anterior" data-gallery-previous>
            <span aria-hidden="true">←</span>
          </button>
          <button class="premium-gallery-control premium-gallery-next" type="button" aria-label="Ver imagen siguiente" data-gallery-next>
            <span aria-hidden="true">→</span>
          </button>
          <span class="premium-image-index">NEKOVA OBJECTS &nbsp; — &nbsp; {% if is_reading_stand %}8{% elsif is_k25_light %}15{% elsif is_ergonomic_cushion %}8{% elsif is_orthopedic_cushion %}12{% else %}{{ featured_product.media.size }}{% endif %} IMÁGENES</span>
        </div>
        <div class="premium-gallery-thumbs" aria-label="Galería del producto">
          {% if is_reading_stand %}
          <button class="is-active" type="button" aria-label="Ver atril de madera" aria-pressed="true" data-premium-image="{{ 'product-media-Hb5f1ee0a42944e8da27b90df6e3ed1877.jpg' | asset_url }}" data-premium-alt="Atril de madera ajustable para laptop, libros y tabletas">
            <img src="{{ 'product-media-Hb5f1ee0a42944e8da27b90df6e3ed1877.jpg' | asset_url }}" alt="" width="1200" height="1500" loading="lazy">
          </button>
          <button type="button" aria-label="Ver atril con libro abierto" aria-pressed="false" data-premium-image="{{ 'product-media-Hfa9cf59005624810920467ea450cbfb5o.jpg' | asset_url }}" data-premium-alt="Atril de madera con libro abierto">
            <img src="{{ 'product-media-Hfa9cf59005624810920467ea450cbfb5o.jpg' | asset_url }}" alt="" width="1200" height="1500" loading="lazy">
          </button>
          <button type="button" aria-label="Ver soporte y ranura de almacenamiento" aria-pressed="false" data-premium-image="{{ 'product-media-H028aa62769ca4ad9b54aca33682d19ec0.jpg' | asset_url }}" data-premium-alt="Soporte de madera ajustable">
            <img src="{{ 'product-media-H028aa62769ca4ad9b54aca33682d19ec0.jpg' | asset_url }}" alt="" width="1200" height="1500" loading="lazy">
          </button>
          <button type="button" aria-label="Ver el soporte desde otro ángulo" aria-pressed="false" data-premium-image="{{ 'product-media-H2b4cc26ef0d8449ba2492fe241016991o.jpg' | asset_url }}" data-premium-alt="Vista alternativa del atril">
            <img src="{{ 'product-media-H2b4cc26ef0d8449ba2492fe241016991o.jpg' | asset_url }}" alt="" width="1200" height="1500" loading="lazy">
          </button>
          <button type="button" aria-label="Ver detalles del producto" aria-pressed="false" data-premium-image="{{ 'product-media-H43efb61d5f9348f1b53da0d6bc37cba9y.jpg' | asset_url }}" data-premium-alt="Detalle del soporte portátil de madera">
            <img src="{{ 'product-media-H43efb61d5f9348f1b53da0d6bc37cba9y.jpg' | asset_url }}" alt="" width="1200" height="1500" loading="lazy">
          </button>
          <button type="button" aria-label="Ver clip elevable para libros" aria-pressed="false" data-premium-image="{{ 'product-media-H5ba6a17b211f44a7aa2103ffaa26e290v.jpg' | asset_url }}" data-premium-alt="Detalle del soporte para libros">
            <img src="{{ 'product-media-H5ba6a17b211f44a7aa2103ffaa26e290v.jpg' | asset_url }}" alt="" width="1200" height="1500" loading="lazy">
          </button>
          <button type="button" aria-label="Ver otra vista del soporte" aria-pressed="false" data-premium-image="{{ 'product-media-Hb24d8690081143bdac982e5102f33c18C.jpg' | asset_url }}" data-premium-alt="Vista adicional del atril de madera">
            <img src="{{ 'product-media-Hb24d8690081143bdac982e5102f33c18C.jpg' | asset_url }}" alt="" width="1200" height="1500" loading="lazy">
          </button>
          <button type="button" aria-label="Ver el soporte en un escritorio" aria-pressed="false" data-premium-image="{{ 'product-media-Hb5f1ee0a42944e8da27b90df6e3ed1877.jpg' | asset_url }}" data-premium-alt="Soporte de lectura portátil en un espacio de trabajo">
            <img src="{{ 'product-media-Hb5f1ee0a42944e8da27b90df6e3ed1877.jpg' | asset_url }}" alt="" width="1200" height="1500" loading="lazy">
          </button>
          <button type="button" aria-label="Ver detalle del soporte para laptop y tabletas" aria-pressed="false" data-premium-image="{{ 'product-media-He1c69a86185942a6b7db4bcdd258049el.jpg' | asset_url }}" data-premium-alt="Detalle del atril ajustable para laptop, libros y tabletas">
            <img src="{{ 'product-media-He1c69a86185942a6b7db4bcdd258049el.jpg' | asset_url }}" alt="" width="1200" height="1500" loading="lazy">
          </button>
          {% elsif is_k25_light %}
            {% assign light_gallery_images = 'product-media-k25-video-light-02.jpg,product-media-k25-video-light-03.jpg,product-media-k25-video-light-04.jpg,product-media-k25-video-light-05.jpg,product-media-k25-video-light-main.jpg,product-media-k25-video-light-07.jpg,product-media-k25-video-light-08.jpg,product-media-k25-video-light-09.jpg,product-media-k25-video-light-10.jpg,product-media-k25-video-light-11.jpg,product-media-k25-video-light-12.jpg,product-media-k25-video-light-13.jpg,product-media-k25-video-light-14.jpg,product-media-k25-video-light-15.jpg,product-media-k25-video-light-16.jpg' | split: ',' %}
            {% for image_file in light_gallery_images %}
              <button class="{% if forloop.first %}is-active{% endif %}" type="button" aria-label="Ver lámpara K25, imagen {{ forloop.index }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" data-premium-image="{{ image_file | asset_url }}" data-premium-alt="Lámpara de video K25 RGB, imagen {{ forloop.index }}">
                <img src="{{ image_file | asset_url }}" alt="" loading="lazy">
              </button>
            {% endfor %}
          {% elsif is_ergonomic_cushion %}
            {% assign cushion_gallery_images = 'product-media-cojin-ergonomico-07.jpg,product-media-cojin-ergonomico-01.jpg,product-media-cojin-ergonomico-02.jpg,product-media-cojin-ergonomico-03.jpg,product-media-cojin-ergonomico-04.jpg,product-media-cojin-ergonomico-05.jpg,product-media-cojin-ergonomico-06.jpg,product-media-cojin-ergonomico-08.jpg' | split: ',' %}
            {% for image_file in cushion_gallery_images %}
              <button class="{% if forloop.first %}is-active{% endif %}" type="button" aria-label="Ver cojín ergonómico, imagen {{ forloop.index }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" data-premium-image="{{ image_file | asset_url }}" data-premium-alt="Cojín ergonómico de doble capa, imagen {{ forloop.index }}">
                <img src="{{ image_file | asset_url }}" alt="" loading="lazy">
              </button>
            {% endfor %}
          {% elsif is_orthopedic_cushion %}
            {% assign orthopedic_gallery_images = 'product-media-cojin-ortopedico-01.jpg,product-media-cojin-ortopedico-02.jpg,product-media-cojin-ortopedico-03.jpg,product-media-cojin-ortopedico-04.jpg,product-media-cojin-ortopedico-05.jpg,product-media-cojin-ortopedico-06.jpg,product-media-cojin-ortopedico-07.jpg,product-media-cojin-ortopedico-08.jpg,product-media-cojin-ortopedico-09.jpg,product-media-cojin-ortopedico-10.jpg,product-media-cojin-ortopedico-11.jpg,product-media-cojin-ortopedico-12.jpg' | split: ',' %}
            {% for image_file in orthopedic_gallery_images %}
              <button class="{% if forloop.first %}is-active{% endif %}" type="button" aria-label="Ver cojín ergonómico en U, imagen {{ forloop.index }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" data-premium-image="{{ image_file | asset_url }}" data-premium-alt="Cojín ergonómico en U, imagen {{ forloop.index }}">
                <img src="{{ image_file | asset_url }}" alt="" width="1200" height="1200" loading="lazy">
              </button>
            {% endfor %}
          {% else %}
            {% for media in featured_product.media %}
              {% if media.media_type == 'image' %}
                <button type="button" aria-label="Ver {{ featured_product.title | escape }} · imagen {{ forloop.index }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" data-premium-image="{{ media | image_url: width: 1800 }}" data-premium-alt="{{ media.alt | default: featured_product.title | escape }}">
                  <img src="{{ media | image_url: width: 260 }}" alt="" loading="lazy">
                </button>
              {% endif %}
            {% endfor %}
          {% endif %}
        </div>
        <dialog class="premium-lightbox" aria-label="Galería de imágenes del producto" data-premium-lightbox>
          <div class="premium-lightbox-content">
            <button class="premium-lightbox-close" type="button" aria-label="Cerrar imagen ampliada" data-lightbox-close>
              <span aria-hidden="true">×</span>
            </button>
            <button class="premium-gallery-control premium-lightbox-previous" type="button" aria-label="Ver imagen anterior" data-lightbox-previous>
              <span aria-hidden="true">←</span>
            </button>
            <img class="premium-lightbox-image" alt="" data-lightbox-image>
            <button class="premium-gallery-control premium-lightbox-next" type="button" aria-label="Ver imagen siguiente" data-lightbox-next>
              <span aria-hidden="true">→</span>
            </button>
            <p class="premium-lightbox-caption" aria-live="polite" data-lightbox-caption></p>
          </div>
        </dialog>
      </div>
    </div>

    {% if is_orthopedic_cushion %}
    <section class="premium-needs" aria-labelledby="PremiumNeeds-{{ section.id }}">
      <div class="premium-section-heading">
