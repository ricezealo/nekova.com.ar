  .premium-lightbox-image { display: block; height: calc(100dvh - 8rem); max-height: calc(100dvh - 8rem); max-width: calc(100vw - 10rem); object-fit: contain; touch-action: pan-y; width: auto; }
  .premium-lightbox-close { align-items: center; background: rgba(17, 19, 16, .78); border: 1px solid rgba(255, 255, 255, .25); border-radius: 50%; color: var(--premium-ink); cursor: pointer; display: flex; font-size: 3.2rem; height: 4.8rem; justify-content: center; line-height: 1; padding: 0 0 .3rem; position: absolute; right: 2.4rem; top: 2.4rem; width: 4.8rem; z-index: 3; }
  .premium-lightbox-previous { left: 2.4rem; }
  .premium-lightbox-next { right: 2.4rem; }
  .premium-lightbox-caption { bottom: 1rem; color: var(--premium-ink); font-size: 1.2rem; left: 7rem; letter-spacing: .06em; margin: 0; position: absolute; right: 7rem; text-align: center; }
  .premium-marquee { align-items: center; border-bottom: 1px solid var(--premium-line); border-top: 1px solid var(--premium-line); color: var(--premium-muted); display: flex; flex-wrap: wrap; font-size: .95rem; gap: 1.4rem; justify-content: space-around; letter-spacing: .2em; padding: 2.1rem 0; }
