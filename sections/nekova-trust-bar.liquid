<div class="nk-trust" role="region" aria-label="Beneficios de compra">
  <div class="nk-trust-track">
    {%- for pass in (1..2) -%}
      <ul class="nk-trust-list"{% if pass == 2 %} aria-hidden="true"{% endif %}>
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            {% render 'nekova-icon', icon: block.settings.icon %}
            <span><strong>{{ block.settings.title | escape }}</strong>{% if block.settings.text != blank %} {{ block.settings.text | escape }}{% endif %}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endfor -%}
  </div>
</div>

{% style %}
  .nk-trust { background: var(--nekova-accent-soft); color: var(--nekova-ink); font-family: var(--nekova-font-body); overflow: hidden; }
  .nk-trust-track { display: flex; justify-content: center; margin: 0 auto; max-width: 1280px; padding: 0 5rem; }
  .nk-trust-list { display: flex; flex: 1; gap: 2.4rem; justify-content: space-between; list-style: none; margin: 0; padding: 1.4rem 0; }
  .nk-trust-list[aria-hidden='true'] { display: none; }
  .nk-trust li { align-items: center; display: flex; font-size: 1.35rem; gap: 1rem; white-space: nowrap; }
  .nk-trust li strong { font-weight: 800; }
  .nk-trust svg { color: var(--nekova-accent); flex: 0 0 auto; height: 2.2rem; width: 2.2rem; }
  @media screen and (max-width: 1199px) {
    .nk-trust-track { justify-content: flex-start; max-width: none; padding: 0; width: max-content; }
    .nk-trust-list, .nk-trust-list[aria-hidden='true'] { display: flex; flex: none; gap: 3.2rem; padding: 1.2rem 1.6rem; }
    .nk-trust-track { animation: nk-trust-scroll 28s linear infinite; }
    .nk-trust:hover .nk-trust-track { animation-play-state: paused; }
  }
  @media screen and (max-width: 1199px) and (prefers-reduced-motion: reduce) {
    .nk-trust { overflow-x: auto; }
    .nk-trust-track { animation: none; }
    .nk-trust-list[aria-hidden='true'] { display: none; }
  }
  @keyframes nk-trust-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
{% endstyle %}

{% schema %}
{
  "name": "Nekova · beneficios",
  "class": "nekova-trust-bar-section",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "item",
      "name": "Beneficio",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícono",
          "default": "truck",
          "options": [
            { "value": "truck", "label": "Envío" },
            { "value": "shield", "label": "Escudo" },
            { "value": "return", "label": "Devolución" },
            { "value": "card", "label": "Pago" },
            { "value": "lock", "label": "Pago seguro" },
            { "value": "chat", "label": "Atención" },
            { "value": "check", "label": "Tilde" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Texto destacado",
          "default": "Despacho en el día"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texto complementario"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Nekova · beneficios"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
