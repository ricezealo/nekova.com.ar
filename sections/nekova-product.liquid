    {%- assign nk_gallery_alt = 'Almohada Nekova Somnia de espuma viscoelástica' -%}
    {%- assign nk_tagline = 'Descanso cómodo, en cualquier postura.' -%}
    {%- assign nk_lead = 'Espuma viscoelástica con contorno de mariposa: apoyo para la cabeza y el cuello, de costado o boca arriba.' -%}
    {%- assign nk_checks = 'Espuma viscoelástica que se adapta y recupera su forma||Contorno mariposa para dormir de costado o boca arriba||Funda transpirable, extraíble y lavable' -%}
    {%- capture nk_assure_extra -%}<strong>Llega enrollada y al vacío.</strong> Al abrirla recupera su forma.{%- endcapture -%}
    {%- capture nk_returns_assure -%}<strong>Probala tranquilo:</strong> si no te convence, tenés 10 días para devolverla.{%- endcapture -%}
    {%- assign nk_returns_faq_q = '¿Puedo devolverla si no me convence?' -%}
    {%- assign nk_returns_faq_a = 'Sí. Tenés 10 días desde la compra para devolverla, completa y en perfecto estado. Escribinos y coordinamos la devolución.' -%}
    {%- assign nk_returns_short = '10 días para devolverla' -%}
    {%- capture nk_details -%}La almohada Nekova Somnia es de espuma viscoelástica, con forma de mariposa. El hueco central recibe la cabeza, las alas laterales están pensadas para dormir de costado y el centro, para dormir boca arriba. Los recortes de los costados dejan lugar para apoyar el brazo. La funda es suave y transpirable, tiene cierre y se saca para lavarla. Llega enrollada y envasada al vacío: al abrirla recupera su forma; dejala unas horas para que se expanda del todo.{%- endcapture -%}
    {%- assign nk_specs = 'Medidas::65 × 37,9 cm, 13,3 cm de alto||Relleno::Espuma viscoelástica||Diseño::Contorno mariposa con hueco central||Funda::Tela suave y transpirable, extraíble con cierre y lavable||Color::Gris con laterales blancos||Presentación::Enrollada y envasada al vacío' -%}

    {%- assign nk_uses_eyebrow = 'Para cada postura' -%}
    {%- assign nk_uses_title = 'Pensada para cómo <span class="nk-hl">dormís</span>' -%}
    {%- assign nk_uses_lead = 'De costado, boca arriba o cambiando de posición durante la noche.' -%}
    {%- assign nk_uses_shape = 'portrait' -%}
    {%- capture nk_uses -%}product-media-almohada-vida-01.jpg::Mujer durmiendo de costado sobre la almohada Nekova Somnia::De costado::Las alas laterales acompañan la cabeza y el hombro.||product-media-almohada-vida-02.jpg::Mujer durmiendo boca arriba sobre la almohada Nekova Somnia::Boca arriba::El hueco central recibe la cabeza.||product-media-almohada-vida-03.jpg::Mujer descansando abrazada a la almohada Nekova Somnia::Cuando te das vuelta::La forma de mariposa te acompaña en cada cambio de posición.{%- endcapture -%}

    {%- assign nk_how_eyebrow = 'Cómo funciona' -%}
    {%- assign nk_how_title = 'Forma de <span class="nk-hl">mariposa</span>' -%}
    {%- assign nk_how_lead = 'Cada parte de la almohada está pensada para una forma de dormir.' -%}
    {%- assign nk_how_image = 'product-media-almohada-02.jpg' -%}
    {%- assign nk_how_alt = 'Zonas de la almohada: hueco para la cabeza, zonas para dormir de costado y boca arriba, lugar para el brazo y apoyo para el cuello' -%}
    {%- assign nk_how = 'A::Hueco central::Recibe la cabeza para un apoyo más estable.||B::Alas laterales::Para dormir de costado, con lugar para el hombro.||C::Recortes para el brazo::Podés apoyar el brazo sin aplastar la almohada.' -%}

    {%- assign nk_benefits_eyebrow = 'Detalles que se notan' -%}
    {%- assign nk_benefits_title = 'Diseñada para tu <span class="nk-hl">descanso</span>' -%}
    {%- assign nk_benefits_lead = 'Materiales y formas pensados para dormir más cómodo.' -%}
    {%- assign nk_benefits = 'foam::Espuma viscoelástica::Se adapta a tu forma y recupera la suya.||arc::Contorno mariposa::Una zona para cada postura de dormir.||moon::De costado o boca arriba::Te acompaña aunque cambies de posición.||zip::Funda con cierre::Se saca para lavarla y deja circular el aire.||sizes::65 × 37,9 cm::Y 13,3 cm de alto.||case::Llega al vacío::Enrollada y compacta; al abrirla recupera su forma.' -%}

    {%- assign nk_video = 'almohada.mp4' -%}
    {%- assign nk_video_shape = 'square' -%}
    {%- assign nk_video_poster = 'product-media-almohada-poster.jpg' -%}
    {%- assign nk_video_lead = 'Así llega: enrollada y al vacío. La abrís y recupera su forma.' -%}
    {%- assign nk_video_details = 'product-media-almohada-detalle-espuma.jpg::Núcleo de espuma viscoelástica de la almohada, sin funda::Núcleo de espuma viscoelástica||product-media-almohada-detalle-enrollada.jpg::Almohada enrollada y envasada al vacío, recién llegada::Llega enrollada y al vacío' -%}

    {%- assign nk_compare_title = 'Una almohada común vs. <span class="nk-hl">Nekova</span>' -%}
    {%- assign nk_compare_them = 'Almohada común' -%}
    {%- assign nk_compare = 'Espuma viscoelástica que recupera su forma::a veces||Hueco central para la cabeza::no||Zonas para dormir de costado y boca arriba::no||Lugar para apoyar el brazo::no||Funda extraíble y lavable::a veces' -%}

    {%- assign nk_specs_title = 'Todo lo que tenés que <span class="nk-hl">saber</span>' -%}
    {%- assign nk_specs_lead = 'Mide 65 × 37,9 cm y 13,3 cm de alto. Llega enrollada y al vacío: dejala unas horas para que tome su forma.' -%}
    {%- assign nk_specs_image = 'product-media-almohada-03.jpg' -%}
    {%- assign nk_specs_alt = 'Medidas de la almohada: 65 cm de largo, 37,9 cm de ancho y 13,3 cm de alto' -%}

    {%- capture nk_faq -%}¿Qué medidas tiene?::Mide 65 × 37,9 cm y 13,3 cm de alto.||¿Para qué posición sirve?::Para dormir de costado o boca arriba: tiene una zona pensada para cada postura y un hueco central para la cabeza.||¿Cómo llega?::Enrollada y envasada al vacío. Al abrirla recupera su forma en pocos minutos; te recomendamos dejarla unas horas antes de usarla para que se expanda del todo.||¿Cómo se limpia?::La funda tiene cierre: sacala y lavala por separado. La espuma no se lava; si hace falta, ventilala.||¿Tiene olor al abrirla?::Como toda espuma nueva, al principio puede tener un olor leve. Dejala ventilar unas horas y se va.{%- endcapture -%}
    {%- assign nk_cta_title = 'Dormí más cómodo desde hoy' -%}
{%- endcase -%}
{%- if nk_lead == blank -%}
  {%- assign nk_lead = featured_product.description | strip_html | truncatewords: 26 -%}
{%- endif -%}
{%- assign nk_tagline = section.settings.launch_heading | default: nk_tagline -%}

<script src="{{ 'premium-product-landing.js' | asset_url }}" defer="defer"></script>

<section class="nk-product" data-premium-product aria-labelledby="NkTitle-{{ section.id }}">
  <div class="nk-shell">
    <div class="nk-main" id="NkBuy-{{ section.id }}">
      <div class="nk-gallery" id="NkGallery-{{ section.id }}" data-premium-gallery>
        {%- assign gallery_files = nk_gallery | split: ',' -%}
        <div class="nk-gallery-main premium-gallery-main">
          <button class="nk-gallery-open" type="button" aria-label="Ampliar imagen del producto" data-gallery-open>
            {%- if gallery_files.size > 0 -%}
              <img src="{{ gallery_files.first | asset_url }}" alt="{{ nk_gallery_alt | escape }}" width="1200" height="1200" fetchpriority="high" data-premium-main-image>
            {%- elsif featured_product.featured_image -%}
              <img src="{{ featured_product.featured_image | image_url: width: 1600 }}" alt="{{ featured_product.featured_image.alt | default: featured_product.title | escape }}" fetchpriority="high" data-premium-main-image>
            {%- endif -%}
          </button>
          <button class="nk-gallery-control nk-gallery-previous" type="button" aria-label="Ver imagen anterior" data-gallery-previous>{% render 'nekova-icon', icon: 'arrow-left' %}</button>
          <button class="nk-gallery-control nk-gallery-next" type="button" aria-label="Ver imagen siguiente" data-gallery-next>{% render 'nekova-icon', icon: 'arrow-right' %}</button>
          {%- if has_discount -%}<span class="nk-badge">-{{ discount_percent }}%</span>{%- endif -%}
        </div>
        <div class="nk-gallery-thumbs" aria-label="Galería del producto">
          {%- if gallery_files.size > 0 -%}
            {%- for image_file in gallery_files -%}
              <button class="{% if forloop.first %}is-active{% endif %}" type="button" aria-label="Ver imagen {{ forloop.index }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" data-premium-image="{{ image_file | asset_url }}" data-premium-alt="{{ nk_gallery_alt | escape }}, imagen {{ forloop.index }}">
                <img src="{{ image_file | asset_url }}" alt="" width="1200" height="1200" loading="lazy">
              </button>
            {%- endfor -%}
          {%- else -%}
            {%- for media in featured_product.media -%}
              {%- if media.media_type == 'image' -%}
                <button class="{% if forloop.first %}is-active{% endif %}" type="button" aria-label="Ver imagen {{ forloop.index }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" data-premium-image="{{ media | image_url: width: 1800 }}" data-premium-alt="{{ media.alt | default: featured_product.title | escape }}">
                  <img src="{{ media | image_url: width: 260 }}" alt="" loading="lazy">
                </button>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </div>
        <dialog class="nk-lightbox" aria-label="Galería de imágenes del producto" data-premium-lightbox>
          <div class="nk-lightbox-content premium-lightbox-content">
            <button class="nk-lightbox-close" type="button" aria-label="Cerrar imagen ampliada" data-lightbox-close>{% render 'nekova-icon', icon: 'close' %}</button>
            <button class="nk-gallery-control nk-lightbox-previous" type="button" aria-label="Ver imagen anterior" data-lightbox-previous>{% render 'nekova-icon', icon: 'arrow-left' %}</button>
            <img class="nk-lightbox-image" alt="" data-lightbox-image>
            <button class="nk-gallery-control nk-lightbox-next" type="button" aria-label="Ver imagen siguiente" data-lightbox-next>{% render 'nekova-icon', icon: 'arrow-right' %}</button>
            <p class="nk-lightbox-caption" aria-live="polite" data-lightbox-caption></p>
          </div>
        </dialog>
      </div>

      <div class="nk-buy">
        <p class="nk-tagline">{{ nk_tagline }}</p>
        <h1 class="nk-title" id="NkTitle-{{ section.id }}">{{ featured_product.title | escape }}</h1>
        <p class="nk-lead">{{ nk_lead }}</p>
        <div class="nk-price" aria-label="Precio del producto">
          <span class="nk-price-current">{{ current_price | money_without_trailing_zeros }}</span>
          {%- if has_discount -%}
            <s class="nk-price-was">{{ original_price | money_without_trailing_zeros }}</s>
            <span class="nk-price-off">{{ discount_percent }}% OFF</span>
          {%- endif -%}
        </div>
        {%- if nk_tiers != blank -%}
          <div class="nk-tiers" data-nk-tiers>
            <p class="nk-tiers-title">Llevá más, pagá menos</p>
            <div class="nk-tiers-options">
              {%- assign tier_rows = nk_tiers | split: '||' -%}
              {%- for tier in tier_rows -%}
                {%- assign cells = tier | split: '::' -%}
                {%- assign tier_cents = cells[2] | times: 100 -%}
                <button type="button" class="nk-tier" data-nk-tier="{{ cells[0] }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">
                  <strong>{{ cells[1] }}</strong>
                  <span>{{ tier_cents | money_without_trailing_zeros }}{% if cells[0] != '1' %} c/u{% endif %}</span>
                </button>
              {%- endfor -%}
            </div>
            <p class="nk-tiers-note">Podés combinar colores y talles. El descuento se aplica en el carrito.</p>
          </div>
        {%- endif -%}
        {%- if section.settings.payment_note != blank or shop.enabled_payment_types.size > 0 -%}
          <div class="nk-pay">
            {%- if section.settings.payment_note != blank -%}
              <p class="nk-pay-note">{% render 'nekova-icon', icon: 'card' %}<span>{{ section.settings.payment_note }}</span></p>
            {%- endif -%}
            {%- if shop.enabled_payment_types.size > 0 -%}
              <ul class="nk-pay-icons" role="list" aria-label="Medios de pago">
                {%- for type in shop.enabled_payment_types -%}
                  <li>{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if featured_product != blank and featured_product.available -%}
          {% form 'product', featured_product, class: 'nk-buy-form' %}
            {%- if has_multi_options -%}
              {%- comment -%} Several options (e.g. Color + Talle): one group per option, the JS resolves the variant. {%- endcomment -%}
              {%- capture nk_variants_json -%}[{%- for v in featured_product.variants -%}
                {%- liquid
                  assign v_image = ''
                  if nk_variant_images != blank
                    assign v_title_handle = v.title | handleize
                    assign v_rules = nk_variant_images | split: ';'
                    for rule in v_rules
                      assign rule_parts = rule | split: '='
                      if rule_parts[0] == '*' or v_title_handle contains rule_parts[0]
                        assign v_image = rule_parts[1] | asset_url
                        break
                      endif
                    endfor
                  elsif v.featured_media
                    assign v_image = v.featured_media | image_url: width: 1800
                  endif
                -%}
                {"id":{{ v.id }},"available":{{ v.available }},"title":{{ v.title | json }},"options":{{ v.options | json }},"image":{{ v_image | json }}}{% unless forloop.last %},{% endunless %}
              {%- endfor -%}]{%- endcapture -%}
              <div class="nk-multi" data-nk-multi-picker>
                <script type="application/json" data-nk-variants>{{ nk_variants_json }}</script>
                <input type="hidden" name="id" value="{{ selected_variant.id }}">
                {%- for option in featured_product.options_with_values -%}
                  {%- assign option_index = forloop.index0 -%}
                  {%- assign option_handle = option.name | handleize -%}
                  {%- assign option_is_color = false -%}
                  {%- if option_handle == 'color' or option_handle == 'colour' or option_handle == 'colores' -%}
                    {%- assign option_is_color = true -%}
                  {%- endif -%}
                  <fieldset class="nk-variants{% if option_is_color %} nk-variants--swatches{% endif %}" data-nk-option="{{ option_index }}">
                    <legend>{{ option.name | escape }}: <strong data-nk-option-label>{{ selected_variant.options[option_index] | escape }}</strong></legend>
                    <div class="nk-variant-options">
                      {%- for value in option.values -%}
                        {%- assign value_name = value.name | default: value -%}
                        {%- assign value_hex = '' -%}
                        {%- if option_is_color -%}
                          {%- assign value_hex = value.swatch.color -%}
                          {%- if value_hex == blank -%}
                            {%- capture value_hex -%}{% render 'nekova-color-hex', name: value_name %}{%- endcapture -%}
                            {%- assign value_hex = value_hex | strip -%}
                          {%- endif -%}
                        {%- endif -%}
                        <label class="nk-variant-option">
                          <input type="radio" name="nk-option-{{ section.id }}-{{ option_index }}" value="{{ value_name | escape }}"{% if value_name == selected_variant.options[option_index] %} checked{% endif %}>
                          {%- if value_hex != blank -%}
                            <span class="nk-swatch" style="background-color: {{ value_hex }};" aria-hidden="true"></span>
                            <span class="nk-tooltip">{{ value_name | escape }}</span>
                            <span class="visually-hidden">{{ value_name | escape }}</span>
                          {%- else -%}
                            <span class="nk-pill">{{ value_name | escape }}</span>
                          {%- endif -%}
                        </label>
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endfor -%}
                <p class="nk-multi-status" data-nk-multi-status role="status" hidden>Esta combinación no está disponible por ahora.</p>
              </div>
            {%- elsif has_variant_choice -%}
              {%- assign variant_option_handle = variant_option_name | handleize -%}
              {%- assign is_color_option = false -%}
              {%- if variant_option_handle == 'color' or variant_option_handle == 'colour' or variant_option_handle == 'colores' -%}
                {%- assign is_color_option = true -%}
              {%- endif -%}
              <fieldset class="nk-variants{% if is_color_option %} nk-variants--swatches{% endif %}" id="PremiumVariants-{{ section.id }}" data-premium-variant-picker>
                <legend>{{ variant_option_name | escape }}: <strong data-premium-variant-label>{{ selected_variant.title | escape }}</strong></legend>
                <div class="nk-variant-options">
                  {%- for variant in featured_product.variants -%}
                    {%- liquid
                      assign variant_image = ''
                      if nk_variant_images != blank
                        # "keyword=file;...;*=file": first keyword contained in the variant name wins, * is the default.
                        assign variant_title_handle = variant.title | handleize
                        assign variant_image_rules = nk_variant_images | split: ';'
                        for rule in variant_image_rules
                          assign rule_parts = rule | split: '='
                          if rule_parts[0] == '*' or variant_title_handle contains rule_parts[0]
                            assign variant_image = rule_parts[1] | asset_url
                            break
                          endif
                        endfor
                      elsif variant.featured_media
                        assign variant_image = variant.featured_media | image_url: width: 1800
                      endif

                      assign swatch_color = ''
                      assign swatch_image = ''
                      if is_color_option
                        for option_value in featured_product.options_with_values.first.values
                          assign option_value_name = option_value.name | default: option_value
                          if option_value_name == variant.option1
                            assign swatch_color = option_value.swatch.color
                            if option_value.swatch.image
                              assign swatch_image = option_value.swatch.image | image_url: width: 80
                            endif
                          endif
                        endfor
                        # Fallback when the Shopify option value has no swatch: product colors by name.
                        if swatch_color == blank and swatch_image == blank
                          assign variant_color_handle = variant.option1 | handleize
                          case variant_color_handle
                            when 'gris'
                              assign swatch_color = '#7b8287'
                            when 'gris-claro'
                              assign swatch_color = '#b8bdc1'
                            when 'gris-oscuro'
                              assign swatch_color = '#4b4f53'
                            when 'azul-marino'
                              assign swatch_color = '#252b5c'
                            when 'azul'
                              assign swatch_color = '#2f4f8a'
                            when 'celeste'
                              assign swatch_color = '#8fb8d8'
                            when 'negro'
                              assign swatch_color = '#1d1d1b'
                            when 'blanco'
                              assign swatch_color = '#f4f3ef'
                            when 'beige', 'crema'
                              assign swatch_color = '#d9c7a7'
                            when 'marron', 'cafe', 'madera'
                              assign swatch_color = '#7a5638'
                            when 'verde'
                              assign swatch_color = '#4d6b4a'
                            when 'rojo'
                              assign swatch_color = '#a83232'
                            when 'naranja'
                              assign swatch_color = '#f26a1b'
                            when 'rosa'
                              assign swatch_color = '#d8a1a8'
                          endcase
                        endif
                      endif
                      assign has_swatch = false
                      if swatch_color != blank or swatch_image != blank
                        assign has_swatch = true
                      endif
                    -%}
                    <label class="nk-variant-option">
                      <input type="radio" name="id" value="{{ variant.id }}" data-variant-title="{{ variant.title | escape }}"{% if variant_image != blank %} data-variant-image="{{ variant_image }}"{% endif %}{% if variant.id == selected_variant.id %} checked{% endif %}{% unless variant.available %} disabled{% endunless %}>
                      {%- if has_swatch -%}
                        <span class="nk-swatch" style="{% if swatch_image != blank %}background-image: url('{{ swatch_image }}');{% else %}background-color: {{ swatch_color }};{% endif %}" aria-hidden="true"></span>
                        <span class="nk-tooltip">{{ variant.title | escape }}{% unless variant.available %} · Agotado{% endunless %}</span>
                      {%- else -%}
                        <span class="nk-pill">{{ variant.title | escape }}{% unless variant.available %} · Agotado{% endunless %}</span>
                      {%- endif -%}
                    </label>
                  {%- endfor -%}
                  <a class="nk-variant-preview" href="#NkGallery-{{ section.id }}" data-premium-variant-preview hidden>
                    <img alt="" width="1200" height="1200">
                    <span class="visually-hidden">Ver la galería</span>
                  </a>
                </div>
              </fieldset>
            {%- else -%}
              <input type="hidden" name="id" value="{{ selected_variant.id }}">
            {%- endif -%}
            <div class="nk-buy-row">
              <div class="nk-qty" data-nk-qty>
                <button type="button" data-nk-qty-step="-1" aria-label="Restar una unidad">−</button>
                <input type="number" name="quantity" value="1" min="1" max="10" inputmode="numeric" aria-label="Cantidad">
                <button type="button" data-nk-qty-step="1" aria-label="Sumar una unidad">+</button>
              </div>
              <button class="nk-button nk-button--cart" type="submit" name="add">{% render 'nekova-icon', icon: 'cart' %}<span>Agregar al carrito</span></button>
            </div>
          {% endform %}

          {%- comment -%} Waitlist for sold-out variants while others are available. {%- endcomment -%}
          {%- liquid
            assign soldout_count = 0
            for variant in featured_product.variants
              unless variant.available
                assign soldout_count = soldout_count | plus: 1
              endunless
            endfor
          -%}
          {%- if soldout_count > 0 -%}
            <details class="nk-waitlist"{% if stock_notification_registered %} open{% endif %}>
              <summary>¿Querés otro color? Avisame cuando llegue</summary>
              {% form 'customer', id: 'NkWaitlistForm', class: 'nk-stock-form premium-stock-form nk-waitlist-form' %}
                {%- if form.posted_successfully? or stock_notification_registered -%}
                  <p class="nk-stock-success" role="status">¡Listo! Te vamos a avisar cuando vuelva a estar disponible.</p>
                {%- else -%}
                  <label for="NkWaitlistVariant-{{ section.id }}">Color</label>
                  <select id="NkWaitlistVariant-{{ section.id }}" name="contact[tags]">
                    {%- for variant in featured_product.variants -%}
                      {%- unless variant.available -%}
                        <option value="back-in-stock, back-in-stock-{{ featured_product.handle }}, back-in-stock-{{ featured_product.handle }}-{{ variant.title | handleize }}">{{ variant.title | escape }}</option>
                      {%- endunless -%}
                    {%- endfor -%}
                  </select>
                  <label class="visually-hidden" for="NkWaitlistEmail-{{ section.id }}">Tu correo electrónico</label>
                  <div class="nk-stock-row">
                    <input id="NkWaitlistEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" placeholder="nombre@correo.com" required>
                    <button type="submit" class="nk-button">Avisarme</button>
                  </div>
                  <label class="nk-stock-consent" for="NkWaitlistConsent-{{ section.id }}">
                    <input id="NkWaitlistConsent-{{ section.id }}" type="checkbox" name="contact[accepts_marketing]" value="true" required>
                    <span>Acepto recibir por email un aviso cuando este color esté disponible.</span>
                  </label>
                {%- endif -%}
              {% endform %}
            </details>
          {%- endif -%}

          {%- comment -%} Combo: adds the current variant plus a complementary product (discount configured in Shopify). {%- endcomment -%}
          {%- if nk_combo_handle != blank -%}
            {%- assign combo_product = all_products[nk_combo_handle] -%}
            {%- if combo_product != blank and combo_product.available and combo_product.handle != featured_product.handle -%}
              <div class="nk-combo" data-nk-combo>
                {%- if combo_product.featured_image -%}
                  <span class="nk-combo-media"><img src="{{ combo_product.featured_image | image_url: width: 240 }}" alt="" width="120" height="120" loading="lazy"></span>
                {%- endif -%}
                <div class="nk-combo-body">
                  <span class="nk-combo-eyebrow">{{ section.settings.combo_heading }}</span>
                  <strong>{{ combo_product.title | escape }}</strong>
                  <span class="nk-combo-price">+ {{ combo_product.price | money_without_trailing_zeros }}</span>
                  {%- if section.settings.combo_note != blank -%}<span class="nk-combo-note">{{ section.settings.combo_note }}</span>{%- endif -%}
                </div>
                <button type="button" class="nk-combo-button" data-nk-combo-add data-combo-variant="{{ combo_product.selected_or_first_available_variant.id }}">Agregar los dos</button>
                <p class="nk-combo-error" data-nk-combo-error role="alert" hidden>No pudimos agregar los productos. Probá de nuevo.</p>
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- elsif featured_product != blank -%}
          <div class="nk-stock">
            <p class="nk-stock-status">Próximamente</p>
            <p>Dejanos tu email y te avisamos cuando esté disponible.</p>
            {% form 'customer', id: stock_form_id, class: 'nk-stock-form premium-stock-form' %}
              {% if form.posted_successfully? or stock_notification_registered %}
                <p class="nk-stock-success" role="status">¡Listo! Te vamos a avisar cuando esté disponible.</p>
              {% else %}
                {% if form.errors %}
                  <p class="nk-stock-error" role="alert">No pudimos registrar tu email. Revisá el dato e intentá nuevamente.</p>
                {% endif %}
                <input type="hidden" name="contact[tags]" value="back-in-stock, back-in-stock-{{ featured_product.handle }}">
                <label class="visually-hidden" for="NkStockEmail-{{ section.id }}">Tu correo electrónico</label>
                <div class="nk-stock-row">
                  <input id="NkStockEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" placeholder="nombre@correo.com" required>
                  <button type="submit" class="nk-button">Avisarme</button>
                </div>
                <label class="nk-stock-consent" for="NkStockConsent-{{ section.id }}">
                  <input id="NkStockConsent-{{ section.id }}" type="checkbox" name="contact[accepts_marketing]" value="true" required>
                  <span>Acepto recibir por email un aviso cuando este producto esté disponible.</span>
                </label>
              {% endif %}
            {% endform %}
          </div>
        {%- endif -%}

        <ul class="nk-assure" role="list">
          {%- if nk_assure_extra != blank -%}
            <li>{% render 'nekova-icon', icon: 'sizes' %}<span>{{ nk_assure_extra }}</span></li>
          {%- endif -%}
          <li>{% render 'nekova-icon', icon: 'return' %}<span>{{ nk_returns_assure }}</span></li>
          {%- assign free_shipping_threshold = settings.nekova_free_shipping_threshold | default: 0 -%}
          {%- if free_shipping_threshold > 0 -%}
            <li>{% render 'nekova-icon', icon: 'truck' %}<span><strong>Envío gratis</strong> en compras desde {{ free_shipping_threshold | times: 100 | money_without_trailing_zeros }}.</span></li>
          {%- endif -%}
          <li>{% render 'nekova-icon', icon: 'chat' %}<span><strong>Atención por WhatsApp</strong> antes y después de comprar.</span></li>
          {%- if section.settings.shipping_note != blank -%}
            <li>{% render 'nekova-icon', icon: 'truck' %}<span>{{ section.settings.shipping_note }}</span></li>
          {%- endif -%}
        </ul>

        {%- if nk_checks != blank -%}
          <ul class="nk-checks">
            {%- assign check_items = nk_checks | split: '||' -%}
            {%- for item in check_items -%}
              <li>{% render 'nekova-icon', icon: 'check' %} {{ item }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <div class="nk-accordions">
          <details>
            <summary>Detalles del producto</summary>
            <div class="nk-accordion-body">
              {%- if nk_details != blank -%}
                <p>{{ nk_details }}</p>
              {%- else -%}
                <div class="rte">{{ featured_product.description }}</div>
              {%- endif -%}
            </div>
          </details>
          {%- if nk_specs != blank or featured_product.metafields.custom.specifications != blank -%}
            <details>
              <summary>Medidas y materiales</summary>
              <div class="nk-accordion-body">
                {%- if nk_specs != blank -%}
                  <dl class="nk-specs">
                    {%- assign spec_rows = nk_specs | split: '||' -%}
                    {%- for row in spec_rows -%}
                      {%- assign cells = row | split: '::' -%}
                      <div><dt>{{ cells[0] }}</dt><dd>{{ cells[1] }}</dd></div>
                    {%- endfor -%}
                  </dl>
                {%- else -%}
                  <div class="rte">{{ featured_product.metafields.custom.specifications | metafield_tag }}</div>
                {%- endif -%}
              </div>
            </details>
          {%- endif -%}
          <details>
            <summary>Envío y devoluciones</summary>
            <div class="nk-accordion-body">
              <p>Las compras realizadas en días hábiles antes de las 13:00hs se despachan ese mismo día; si comprás después de ese horario, un fin de semana o un feriado, el día hábil siguiente. El costo y el plazo de envío se calculan según tu destino y los ves en el checkout antes de pagar.</p>
              <p>{{ nk_returns_text }}</p>
            </div>
          </details>
        </div>
      </div>
    </div>
  </div>

  {%- if nk_uses_title != blank -%}
    <section class="nk-section nk-section--panel" aria-labelledby="NkUses-{{ section.id }}">
      <div class="nk-shell">
        <div class="nk-head nk-head--split">
          <div>
            <p class="nk-eyebrow">{{ nk_uses_eyebrow }}</p>
            <h2 id="NkUses-{{ section.id }}">{{ nk_uses_title }}</h2>
          </div>
          <p class="nk-head-lead">{{ nk_uses_lead }}</p>
        </div>
        <div class="nk-uses{% if nk_uses_shape == 'landscape' %} nk-uses--landscape{% endif %}" data-nk-autoplay="3000">
          {%- assign use_items = nk_uses | split: '||' -%}
          {%- for item in use_items -%}
            {%- assign cells = item | split: '::' -%}
            <figure>
              <img src="{{ cells[0] | asset_url }}" alt="{{ cells[1] }}" width="900" height="{% if nk_uses_shape == 'landscape' %}600{% else %}1125{% endif %}" loading="lazy">
              <figcaption><span class="nk-num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span><strong>{{ cells[2] }}</strong>{{ cells[3] }}</figcaption>
            </figure>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- if nk_how_title != blank -%}
    <section class="nk-section nk-section--dark" aria-labelledby="NkHow-{{ section.id }}">
      <div class="nk-shell nk-split">
        <div class="nk-how-media">
          <img src="{{ nk_how_image | asset_url }}" alt="{{ nk_how_alt }}" width="1200" height="1200" loading="lazy">
        </div>
        <div>
          <p class="nk-eyebrow">{{ nk_how_eyebrow }}</p>
          <h2 id="NkHow-{{ section.id }}">{{ nk_how_title }}</h2>
          <p class="nk-head-lead">{{ nk_how_lead }}</p>
          <ol class="nk-zones">
            {%- assign how_items = nk_how | split: '||' -%}
            {%- for item in how_items -%}
              {%- assign cells = item | split: '::' -%}
              <li><span aria-hidden="true">{{ cells[0] }}</span><div><strong>{{ cells[1] }}</strong>{{ cells[2] }}</div></li>
            {%- endfor -%}
          </ol>
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- if nk_benefits_title != blank -%}
    <section class="nk-section" aria-labelledby="NkBenefits-{{ section.id }}">
      <div class="nk-shell">
        <div class="nk-head nk-head--split">
          <div>
            <p class="nk-eyebrow">{{ nk_benefits_eyebrow }}</p>
            <h2 id="NkBenefits-{{ section.id }}">{{ nk_benefits_title }}</h2>
          </div>
          <p class="nk-head-lead">{{ nk_benefits_lead }}</p>
        </div>
        <ul class="nk-benefits" role="list">
          {%- assign benefit_items = nk_benefits | split: '||' -%}
          {%- for item in benefit_items -%}
            {%- assign cells = item | split: '::' -%}
            <li><span class="nk-benefit-icon">{% render 'nekova-icon', icon: cells[0] %}</span><strong>{{ cells[1] }}</strong><p>{{ cells[2] }}</p></li>
          {%- endfor -%}
        </ul>
      </div>
    </section>
  {%- endif -%}

  {%- if nk_video != blank -%}
    <section class="nk-section nk-section--soft" aria-labelledby="NkVideo-{{ section.id }}">
      <div class="nk-shell nk-split nk-split--video">
        <div>
          <p class="nk-eyebrow">En detalle</p>
          <h2 id="NkVideo-{{ section.id }}">Miralo de <span class="nk-hl">cerca</span></h2>
          <p class="nk-head-lead">{{ nk_video_lead }}</p>
          {%- if nk_video_details != blank -%}
            <div class="nk-details">
              {%- assign detail_items = nk_video_details | split: '||' -%}
              {%- for item in detail_items -%}
                {%- assign cells = item | split: '::' -%}
                <figure><img src="{{ cells[0] | asset_url }}" alt="{{ cells[1] }}" width="900" height="1125" loading="lazy"><figcaption>{{ cells[2] }}</figcaption></figure>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
        <div class="nk-video-frame{% if nk_video_shape == 'square' %} nk-video-frame--square{% endif %}">
          <video controls playsinline preload="metadata" poster="{{ nk_video_poster | asset_url }}" aria-label="Video de {{ featured_product.title | escape }}">
            <source src="{{ nk_video | asset_url }}" type="video/mp4">
            Tu navegador no puede reproducir este video.
          </video>
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- if nk_compare_title != blank -%}
    <section class="nk-section" aria-labelledby="NkCompare-{{ section.id }}">
      <div class="nk-shell">
        <div class="nk-head nk-head--center">
          <p class="nk-eyebrow">La diferencia</p>
          <h2 id="NkCompare-{{ section.id }}">{{ nk_compare_title }}</h2>
        </div>
        <div class="nk-compare" role="table" aria-label="Comparación con {{ nk_compare_them | downcase }}">
          <div class="nk-compare-row nk-compare-head" role="row">
            <span role="columnheader"><span class="visually-hidden">Característica</span></span>
            <span role="columnheader">{{ nk_compare_them }}</span>
            <span role="columnheader" class="nk-compare-us"><img src="{{ 'nekova-mark-white.svg' | asset_url }}" alt="" width="22" height="22"><span class="nk-compare-brand">Nekova</span></span>
          </div>
          {%- assign compare_rows = nk_compare | split: '||' -%}
          {%- for row in compare_rows -%}
            {%- assign cells = row | split: '::' -%}
            <div class="nk-compare-row" role="row">
              <span role="rowheader">{{ cells[0] }}</span>
              <span role="cell" class="nk-compare-them">
                {%- if cells[1] == 'no' -%}{% render 'nekova-icon', icon: 'cross' %}<span class="visually-hidden">No</span>{%- else -%}{{ cells[1] | capitalize }}{%- endif -%}
              </span>
              <span role="cell" class="nk-compare-us">{% render 'nekova-icon', icon: 'check' %}<span class="visually-hidden">Sí</span></span>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- if nk_specs_title != blank -%}
    <section class="nk-section nk-section--panel" aria-labelledby="NkSpecs-{{ section.id }}">
      <div class="nk-shell nk-split nk-split--specs">
        <div>
          <p class="nk-eyebrow">Ficha técnica</p>
          <h2 id="NkSpecs-{{ section.id }}">{{ nk_specs_title }}</h2>
          <p class="nk-head-lead">{{ nk_specs_lead }}</p>
          <img class="nk-specs-image" src="{{ nk_specs_image | asset_url }}" alt="{{ nk_specs_alt }}" width="1200" height="1200" loading="lazy">
        </div>
        <dl class="nk-spec-table">
          {%- assign spec_rows = nk_specs | split: '||' -%}
          {%- for row in spec_rows -%}
            {%- assign cells = row | split: '::' -%}
            <div><dt>{{ cells[0] }}</dt><dd>{{ cells[1] }}</dd></div>
          {%- endfor -%}
        </dl>
      </div>
    </section>
  {%- endif -%}

  {%- liquid
    # Cross-sell: other products of the store catalog (collection "all").
    assign other_products = ''
    assign other_count = 0
    for candidate in collections.all.products limit: 4
      if candidate.id != featured_product.id
        assign other_count = other_count | plus: 1
      endif
    endfor
  -%}
  {%- if other_count > 0 -%}
    <section class="nk-section nk-section--panel" aria-labelledby="NkMore-{{ section.id }}">
      <div class="nk-shell">
        <div class="nk-head nk-head--split">
          <div>
            <p class="nk-eyebrow">Completá tu bienestar</p>
            <h2 id="NkMore-{{ section.id }}">También te puede <span class="nk-hl">interesar</span></h2>
          </div>
          <p class="nk-head-lead">Productos pensados para que trabajes, viajes y descanses más cómodo.</p>
        </div>
        <ul class="nk-more" role="list">
          {%- for candidate in collections.all.products limit: 4 -%}
            {%- if candidate.id == featured_product.id -%}{%- continue -%}{%- endif -%}
            {%- liquid
              assign more_image = ''
              case candidate.handle
                when 'cojin-ortopedico-u'
                  assign more_image = 'product-media-cojin-ortopedico-01.jpg' | asset_url
                when 'tapones-auditivos-silicona'
                  assign more_image = 'product-media-tapones-01.jpg' | asset_url
              endcase
              if more_image == blank and candidate.featured_image
                assign more_image = candidate.featured_image | image_url: width: 900
              endif
            -%}
            <li>
              <a class="nk-more-card" href="{{ candidate.url }}">
                {%- if more_image != blank -%}<span class="nk-more-media"><img src="{{ more_image }}" alt="" width="900" height="900" loading="lazy"></span>{%- endif -%}
                <span class="nk-more-body">
                  <strong>{{ candidate.title | escape }}</strong>
                  <span class="nk-more-price">{{ candidate.price | money_without_trailing_zeros }}</span>
                  <span class="nk-more-link">Ver producto {% render 'nekova-icon', icon: 'arrow-right' %}</span>
                </span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </section>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <section class="nk-section">
      <div class="nk-shell">
        <div class="nk-head nk-head--center"><p class="nk-eyebrow">Opiniones</p><h2>Lo que dicen <span class="nk-hl">quienes lo usan</span></h2></div>
        {%- for block in section.blocks -%}
          {% render block %}
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}

  <section class="nk-section" id="preguntas-frecuentes" aria-labelledby="NkFaq-{{ section.id }}">
    <div class="nk-shell nk-split nk-split--faq">
      <div>
        <p class="nk-eyebrow">Antes de comprar</p>
        <h2 id="NkFaq-{{ section.id }}">Preguntas <span class="nk-hl">frecuentes</span></h2>
        <p class="nk-head-lead">¿Tenés otra duda? <a href="/pages/contact">Escribinos</a> y te ayudamos.</p>
      </div>
      <div class="nk-faq-list">
        {%- if nk_faq != blank -%}
          {%- assign faq_items = nk_faq | split: '||' -%}
          {%- for item in faq_items -%}
            {%- assign cells = item | split: '::' -%}
            <details><summary>{{ cells[0] }}</summary><p>{{ cells[1] }}</p></details>
          {%- endfor -%}
        {%- endif -%}
        <details><summary>¿Cuándo se despacha mi pedido?</summary><p>Las compras realizadas en días hábiles antes de las 13:00hs se despachan ese mismo día. Si comprás después de ese horario, un fin de semana o un feriado, tu pedido sale el día hábil siguiente. El plazo de entrega depende del destino y del operador logístico.</p></details>
        <details><summary>¿Cuánto cuesta el envío?</summary><p>El costo y la estimación de entrega se calculan según tu destino y se muestran en el checkout, antes de confirmar la compra.</p></details>
        <details><summary>{{ nk_returns_faq_q }}</summary><p>{{ nk_returns_faq_a }}</p></details>
        <details><summary>¿Cómo me comunico con ustedes?</summary><p>
          {%- assign faq_whatsapp_digits = settings.nekova_whatsapp | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')' | remove: '.' -%}
          {%- assign faq_email = settings.nekova_email | default: shop.email -%}
          {%- if settings.nekova_whatsapp != blank -%}Por WhatsApp al <a href="https://wa.me/{{ faq_whatsapp_digits }}" target="_blank" rel="noopener">{{ settings.nekova_whatsapp | escape }}</a>{%- if faq_email != blank -%}, por email a <a href="mailto:{{ faq_email }}">{{ faq_email }}</a>{%- endif %} o desde la <a href="/pages/contact">página de contacto</a>. Te respondemos a la brevedad.{%- else -%}Escribinos desde la <a href="/pages/contact">página de contacto</a> y te respondemos a la brevedad.{%- endif -%}
        </p></details>
        <details><summary>¿Qué medios de pago puedo usar?</summary><p>En el checkout vas a ver los medios de pago disponibles y las opciones de cuotas cuando correspondan.</p></details>
      </div>
    </div>
  </section>

  {%- if featured_product != blank -%}
    <div class="nk-cta-band">
      <div class="nk-shell nk-cta">
        {%- if gallery_files.size > 0 -%}
          <img src="{{ gallery_files.first | asset_url }}" alt="" width="1200" height="1200" loading="lazy">
        {%- elsif featured_product.featured_image -%}
          <img src="{{ featured_product.featured_image | image_url: width: 600 }}" alt="" loading="lazy">
        {%- endif -%}
        <div>
          <h2>{{ nk_cta_title }}</h2>
          <p>{{ current_price | money_without_trailing_zeros }} · Despacho en el día · {{ nk_returns_short }}</p>
        </div>
        <a class="nk-button nk-button--light" href="#NkBuy-{{ section.id }}">{% if featured_product.available %}Comprar ahora{% else %}Avisarme{% endif %}</a>
      </div>
    </div>
  {%- endif -%}
</section>

{% style %}
  .nk-product {
    --nk-bg: var(--nekova-bg);
    --nk-panel: var(--nekova-panel);
    --nk-ink: var(--nekova-ink);
    --nk-muted: var(--nekova-muted);
    --nk-line: var(--nekova-line);
    --nk-accent: var(--nekova-accent);
    background: var(--nk-bg);
    color: var(--nk-ink);
    font-family: var(--nekova-font-body);
  }
  .nk-product * { box-sizing: border-box; }
  .nk-shell { margin: 0 auto; max-width: 1280px; padding: 0 5rem; }
  .nk-product h1, .nk-product h2 { color: var(--nk-ink); font-family: var(--nekova-font-heading); font-weight: var(--font-heading-weight); letter-spacing: -.02em; }
  .nk-product a { color: var(--nk-accent); text-underline-offset: .2em; }
  .nk-product svg { flex: 0 0 auto; }
  .nk-product button, .nk-product summary, .nk-variant-option, .nk-product a { touch-action: manipulation; }

  .nk-main { align-items: start; display: grid; gap: 5rem; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); padding: 3.2rem 0 7rem; }
  .nk-gallery { min-width: 0; }
  .nk-gallery-main { aspect-ratio: 1; background: var(--nk-panel); border-radius: var(--nekova-radius-lg); overflow: hidden; position: relative; touch-action: pan-y; }
  .nk-gallery-open { background: transparent; border: 0; cursor: zoom-in; display: block; height: 100%; inset: 0; padding: 0; position: absolute; width: 100%; }
  .nk-gallery-main img { display: block; height: 100%; mix-blend-mode: multiply; object-fit: contain; padding: 6%; width: 100%; }
  .nk-gallery-control { align-items: center; background: var(--nekova-surface); border: 0; border-radius: 50%; box-shadow: 0 .4rem 1.4rem rgba(var(--nekova-ink-rgb), .12); color: var(--nk-ink); cursor: pointer; display: flex; height: 4.4rem; justify-content: center; padding: 0; position: absolute; top: 50%; transform: translateY(-50%); transition: background .2s, color .2s; width: 4.4rem; z-index: 2; }
  .nk-gallery-control:hover { background: var(--nk-accent); color: var(--nekova-on-accent); }
  .nk-gallery-control:focus-visible, .nk-gallery-thumbs button:focus-visible { outline: 2px solid var(--nk-accent); outline-offset: 2px; }
  .nk-gallery-previous { left: 1.6rem; }
  .nk-gallery-next { right: 1.6rem; }
  .nk-badge { background: var(--nekova-warm); border-radius: var(--nekova-radius-pill); color: var(--nekova-on-accent); font-size: 1.3rem; font-weight: 800; left: 1.6rem; padding: .5rem 1.2rem; position: absolute; top: 1.6rem; }
  .nk-gallery-thumbs { display: grid; gap: .8rem; grid-template-columns: repeat(6, minmax(0, 1fr)); margin-top: 1rem; }
  .nk-gallery-thumbs button { aspect-ratio: 1; background: var(--nk-panel); border: 2px solid transparent; border-radius: var(--nekova-radius-sm); cursor: pointer; overflow: hidden; padding: 0; transition: border-color .2s; }
  .nk-gallery-thumbs button.is-active, .nk-gallery-thumbs button:hover { border-color: var(--nk-accent); }
  .nk-gallery-thumbs img { display: block; height: 100%; mix-blend-mode: multiply; object-fit: contain; width: 100%; }
  .nk-lightbox { background: rgba(var(--nekova-bg-rgb), .98); border: 0; height: 100dvh; margin: 0; max-height: none; max-width: none; overflow: hidden; padding: 0; position: fixed; width: 100vw; }
  .nk-lightbox[open] { align-items: center; display: flex; justify-content: center; }
  .nk-lightbox::backdrop { background: rgba(var(--nekova-bg-rgb), .98); }
  .nk-lightbox-content { align-items: center; display: flex; height: 100%; justify-content: center; position: relative; touch-action: pan-y; width: 100%; }
  .nk-lightbox-image { display: block; max-height: calc(100dvh - 8rem); max-width: calc(100vw - 12rem); object-fit: contain; }
  .nk-lightbox-close { align-items: center; background: var(--nk-panel); border: 0; border-radius: 50%; color: var(--nk-ink); cursor: pointer; display: flex; height: 4.8rem; justify-content: center; position: absolute; right: 2.4rem; top: 2.4rem; width: 4.8rem; z-index: 3; }
  .nk-lightbox-previous { left: 2.4rem; }
  .nk-lightbox-next { right: 2.4rem; }
