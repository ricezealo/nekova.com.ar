  .nk-cta { align-items: center; display: grid; gap: 3rem; grid-template-columns: 12rem 1fr auto; padding-bottom: 4.8rem; padding-top: 4.8rem; }
  .nk-cta img { aspect-ratio: 1; background: var(--nekova-surface); border-radius: var(--nekova-radius); display: block; height: auto; object-fit: contain; width: 100%; }
  .nk-product .nk-cta h2 { color: var(--nekova-on-accent); font-size: clamp(2.4rem, 2.6vw, 3.2rem); margin: 0 0 .6rem; }
  .nk-cta p { font-size: 1.5rem; margin: 0; opacity: .88; }

  @media screen and (max-width: 990px) {
    .nk-variant-options { align-items: center; }
    .nk-variant-preview:not([hidden]) { background: var(--nk-panel); border: 1px solid var(--nk-line); border-radius: 1.2rem; display: block; height: 6.4rem; margin-left: auto; overflow: hidden; width: 6.4rem; }
    .nk-variant-preview img { display: block; height: 100%; mix-blend-mode: multiply; object-fit: contain; width: 100%; }
    .nk-gallery { scroll-margin-top: 8rem; }
    .nk-section { padding: 7rem 0; }
    .nk-head--split, .nk-split, .nk-split--video, .nk-split--faq { gap: 3.2rem; grid-template-columns: 1fr; }
    .nk-split--faq > div:first-child { position: static; }
    .nk-uses { gap: 1.2rem; }
    .nk-benefits { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .nk-how-media { margin: 0 auto; max-width: 52rem; width: 100%; }
    .nk-shell { padding: 0 2.4rem; }
    .nk-main { gap: 3.2rem; grid-template-columns: 1fr; padding-bottom: 5rem; }
    .nk-buy { position: static; }
    .nk-cta { grid-template-columns: 9rem 1fr; }
    .nk-cta .nk-button { grid-column: 1 / -1; }
  }
  @media screen and (max-width: 600px) {
    .nk-combo { grid-template-columns: 6rem 1fr; }
    .nk-combo-button { grid-column: 1 / -1; width: 100%; }
    .nk-more-card { gap: 1.4rem; grid-template-columns: 9rem 1fr; padding: 1.2rem; }
    .nk-compare-brand { clip: rect(0 0 0 0); height: 1px; overflow: hidden; position: absolute; white-space: nowrap; width: 1px; }
    .nk-compare-head .nk-compare-us img { height: 2.8rem; width: 2.8rem; }
    .nk-qty { flex-basis: 11.2rem; }
    .nk-qty button { width: 3.6rem; }
    .nk-section { padding: 5.6rem 0; }
    .nk-head { margin-bottom: 3.2rem; }
    .nk-uses { display: flex; gap: 1.2rem; margin: 0 -1.6rem; overflow-x: auto; padding: 0 1.6rem .4rem; scroll-snap-type: x mandatory; }
    .nk-uses figure { flex: 0 0 78%; scroll-snap-align: start; }
    .nk-uses figcaption { padding: 1.6rem 1.8rem 2rem; }
    .nk-benefits { gap: 1.2rem; grid-template-columns: 1fr; }
    .nk-benefits li { align-items: flex-start; display: grid; gap: 0 1.6rem; grid-template-columns: 4.8rem 1fr; padding: 2rem; }
    .nk-benefit-icon { grid-row: span 2; height: 4.8rem; margin: 0; width: 4.8rem; }
    .nk-compare-row > span { font-size: 1.3rem; min-height: 5.6rem; padding: 1.2rem; }
    .nk-compare-head > span { font-size: 1.2rem; letter-spacing: .04em; }
    .nk-spec-table { padding: .8rem 2rem; }
    .nk-spec-table div { gap: .2rem; grid-template-columns: 1fr; padding: 1.4rem 0; }
    .nk-shell { padding: 0 1.6rem; }
    .nk-main { padding-top: 1.6rem; }
    .nk-gallery-main { border-radius: var(--nekova-radius); }
    .nk-gallery-control { height: 3.8rem; width: 3.8rem; }
    .nk-gallery-previous { left: .8rem; }
    .nk-gallery-next { right: .8rem; }
    .nk-gallery-thumbs { display: flex; gap: .6rem; overflow-x: auto; padding-bottom: .4rem; scroll-snap-type: x mandatory; }
    .nk-gallery-thumbs button { flex: 0 0 6.4rem; scroll-snap-align: start; }
    .nk-lightbox-image { max-width: calc(100vw - 2rem); }
    .nk-lightbox-close { right: 1rem; top: 1rem; }
    .nk-lightbox-previous { left: .6rem; }
    .nk-lightbox-next { right: .6rem; }
    .nk-specs div { gap: .2rem; grid-template-columns: 1fr; }
    .nk-cta { gap: 1.6rem; padding-bottom: 4rem; padding-top: 4rem; }
    .nk-stock-row { flex-direction: column; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Nekova · producto",
  "tag": "div",
  "class": "nekova-product-section",
  "settings": [
    {
      "type": "text",
      "id": "combo_heading",
      "label": "Combo: antetítulo",
      "default": "Completá tu compra",
      "info": "Debajo del botón de compra se ofrece el producto complementario (cojín ↔ tapones) con un botón para agregar los dos."
    },
    {
      "type": "text",
      "id": "combo_note",
      "label": "Combo: beneficio",
      "info": "Opcional. Ej.: 10% OFF llevando los dos. El descuento se crea en Shopify → Descuentos (automático)."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Producto",
      "info": "En la página de producto se usa el producto actual. En otras páginas (por ejemplo, el inicio) se muestra este."
    },
    {
      "type": "inline_richtext",
      "id": "launch_heading",
      "label": "Frase destacada",
      "info": "Opcional. Aparece arriba del nombre del producto."
    },
    {
      "type": "inline_richtext",
      "id": "payment_note",
      "label": "Nota de pago",
      "info": "Opcional. Aparece debajo del precio, por ejemplo: Hasta 3 cuotas sin interés. Los íconos de medios de pago se muestran solos."
    },
    {
      "type": "inline_richtext",
      "id": "shipping_note",
      "label": "Nota de envío",
      "info": "Opcional. Aparece junto al botón de compra, por ejemplo: Envíos a todo el país."
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Nekova · producto"
    }
  ]
}
{% endschema %}
