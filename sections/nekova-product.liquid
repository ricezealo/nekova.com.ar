{%- liquid
  assign featured_product = product | default: section.settings.product
  assign selected_variant = featured_product.selected_or_first_available_variant
  assign current_price = selected_variant.price | default: featured_product.price
  assign original_price = selected_variant.compare_at_price | default: featured_product.compare_at_price
  assign has_discount = false
  if original_price > current_price
    assign has_discount = true
    assign discount_percent = original_price | minus: current_price | times: 100.0 | divided_by: original_price | round
  endif

  # Products with their own content. Add new products here and in the content block below.
  assign content_key = ''
  case featured_product.handle
    when 'cojin-ortopedico-u'
      assign content_key = 'cojin'
    when 'tapones-auditivos-silicona'
      assign content_key = 'tapones'
    when 'plantillas-multitalle'
      assign content_key = 'plantillas'
    when 'almohada-nekova-somnia', 'almohada-ergonomica-mariposa'
      assign content_key = 'almohada'
  endcase

  assign has_variant_choice = false
  if featured_product.has_only_default_variant == false and featured_product.variants.size > 1
    assign has_variant_choice = true
    assign variant_option_name = featured_product.options.first | default: 'Variante'
  endif
  assign has_multi_options = false
  if has_variant_choice and featured_product.options.size > 1
    assign has_multi_options = true
  endif
  assign stock_form_id = 'NkStockForm-' | append: section.id
-%}

